<Project Sdk="Microsoft.NET.Sdk">

  <!--
    注入器可行性探针（Phase A1）。
    刻意不加入 GIMI-ModManager.sln，也不被主程序引用：
    按 docs/injection-capability-prd.md 的决策 1，它只是开发机上的自用能力，
    删掉本目录不会影响任何产品行为。

    只能以 x64 运行：远程 LoadLibrary 要求注入器与目标同位数。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>JASM.InjectorProbe</AssemblyName>
    <RootNamespace>JASM.InjectorProbe</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
