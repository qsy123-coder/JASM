<?xml version="1.0" encoding="utf-8"?>
<!--
https://go.microsoft.com/fwlink/?LinkID=208121.
单文件自包含发布：生成单个 exe，用户无需安装 .NET 运行时 / Windows App SDK 运行时。
依赖会打包进 exe，首次启动时解压到 %TEMP% 临时目录。
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <PublishDir>bin\Release\PublishSingleFile</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <TargetFramework>net9.0-windows10.0.22621.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- 单文件模式下 ReadyToRun 收益有限且增大体积，关闭 -->
    <PublishReadyToRun>false</PublishReadyToRun>
    <!-- WinUI/XAML 反射依赖，不做裁剪 -->
    <PublishTrimmed>false</PublishTrimmed>
    <!-- 打包 Windows App SDK 运行时，用户无需安装 -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- 原生 DLL（Microsoft.UI.Xaml 等）嵌入 exe，启动时自解压 -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- 内容文件（XBF、Assets、appsettings.json 等）嵌入 exe，启动时自解压 -->
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
  </PropertyGroup>
</Project>
