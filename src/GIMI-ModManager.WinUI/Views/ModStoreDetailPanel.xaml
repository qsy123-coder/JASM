<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="GIMI_ModManager.WinUI.Views.ModStoreDetailPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:CommunityToolkit.WinUI.UI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:l="using:WinUI3Localizer"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:GIMI_ModManager.WinUI.Models"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter
            x:Key="BoolToVisibilityConverter"
            TrueValue="Visible"
            FalseValue="Collapsed" />

        <!-- 滑入/滑出与市场侧的 ModDetailPanel 同一套参数(420→460 只是抽屉更宽) -->
        <Storyboard x:Name="SlideInStoryboard">
            <DoubleAnimation Storyboard.TargetName="DrawerBorder"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             From="460" To="0" Duration="0:0:0.30">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="PanelRoot"
                             Storyboard.TargetProperty="Opacity"
                             From="0.01" To="1" Duration="0:0:0.25" />
        </Storyboard>

        <Storyboard x:Name="SlideOutStoryboard">
            <DoubleAnimation Storyboard.TargetName="DrawerBorder"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             From="0" To="460" Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="PanelRoot"
                             Storyboard.TargetProperty="Opacity"
                             From="1" To="0.01" Duration="0:0:0.20" />
        </Storyboard>

        <!-- 文件列表的一行。绑定用 x:Bind(条目建完不变,OneTime 足够) -->
        <DataTemplate x:Key="ModStoreFileTemplate" x:DataType="models:ModStoreFileItem">
            <Grid Padding="10,8" RowSpacing="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{x:Bind FileName}" FontSize="13"
                           TextWrapping="Wrap" />
                <Grid Grid.Row="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{x:Bind MetaText}" FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <!-- 归档文件仍然可下,但必须标出来:用户有权知道自己在装一个已被隐藏的东西 -->
                    <Border Grid.Column="1" Padding="6,1" CornerRadius="4"
                            Background="#FF4D4F" VerticalAlignment="Center"
                            Visibility="{x:Bind IsArchived, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock FontSize="10" Foreground="White"
                                   l:Uids.Uid="ModStore_Detail_FileArchived"
                                   Text="已归档" />
                    </Border>
                </Grid>
                <TextBlock Grid.Row="2" Text="{x:Bind Description}" FontSize="11"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Visibility="{x:Bind HasDescription, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="PanelRoot" Visibility="Collapsed" Opacity="0.01">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="460" />
        </Grid.ColumnDefinitions>

        <!-- 点空白处关闭 -->
        <Grid Grid.Column="0" Background="#01000000" IsTapEnabled="True" Tapped="TapCloseArea_Tapped" />

        <Border x:Name="DrawerBorder" Grid.Column="1"
                VerticalAlignment="Stretch"
                BorderBrush="#30000000" BorderThickness="1,0,0,0"
                Background="{ThemeResource SystemControlAcrylicWindowBrush}">
            <Border.RenderTransform>
                <TranslateTransform X="460" />
            </Border.RenderTransform>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Disabled"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="20,0,20,20">

                    <!-- 标题 + 关闭 -->
                    <Grid Margin="0,20,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="16"
                                   FontWeight="Bold" TextWrapping="Wrap" MaxLines="3" />
                        <Button Grid.Column="1" Width="32" Height="32" Padding="0"
                                Background="Transparent" BorderThickness="0"
                                CornerRadius="16" Click="CloseButton_Click">
                            <FontIcon FontSize="12" Glyph="&#xE711;" />
                        </Button>
                    </Grid>

                    <!-- 作者 / 时间 / 内容分级 -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                            <Grid Width="32" Height="32">
                                <Border CornerRadius="16"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                                    <FontIcon FontSize="16" Glyph="&#xE77B;" Foreground="White"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <!-- 详情回来前是空的,圆圈加首字母图标先顶着 -->
                                <Image x:Name="AuthorAvatarImage" Stretch="UniformToFill" />
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding AuthorName}" FontSize="13" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding RelativeTime}" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Border Padding="6,1" CornerRadius="4" Background="#10FFFFFF"
                                            BorderBrush="#30FFFFFF" BorderThickness="0.5"
                                            Visibility="{Binding HasCharacter, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{Binding Character}" FontSize="10"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        <!-- 内容分级:详情端点没有列表侧那个 _bHasContentRatings,这里是 _aContentRatings 非空判定的 -->
                        <Border Grid.Column="1" Padding="6,2" CornerRadius="4" Background="#FF4D4F"
                                VerticalAlignment="Top"
                                Visibility="{Binding HasRatings, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="NSFW" FontSize="10" FontWeight="SemiBold" Foreground="White" />
                                <TextBlock Text="{Binding NsfwLabels}" FontSize="10" Foreground="White" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 统计:浏览 / 点赞 / 评论 / 下载(下载量只有详情有) -->
                    <StackPanel Orientation="Horizontal" Spacing="18" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon FontSize="12" Glyph="&#xE890;"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      VerticalAlignment="Center" />
                            <TextBlock FontSize="12" VerticalAlignment="Center" Text="{Binding ViewsCount}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon FontSize="12" Glyph="&#xEB52;"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      VerticalAlignment="Center" />
                            <TextBlock FontSize="12" VerticalAlignment="Center" Text="{Binding LikesCount}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon FontSize="12" Glyph="&#xE8F2;"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      VerticalAlignment="Center" />
                            <TextBlock FontSize="12" VerticalAlignment="Center" Text="{Binding CommentsCount}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon FontSize="12" Glyph="&#xE896;"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      VerticalAlignment="Center" />
                            <TextBlock FontSize="12" VerticalAlignment="Center" Text="{Binding DownloadsCount}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 版本 / 日期 / 状态 -->
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,14">
                        <TextBlock Text="{Binding VersionText}" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding AddedText}" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding UpdatedText}" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding UpdatesText}" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Border Padding="6,1" CornerRadius="4" Background="#FF8C00"
                                Visibility="{Binding IsObsolete, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock FontSize="10" Foreground="White"
                                       l:Uids.Uid="ModStore_Detail_Obsolete" Text="已过时" />
                        </Border>
                        <!-- 安装状态:两个角标可以同时亮(装着、但站上有新版)。
                             判定在 Core 的 ModStoreInstallStatus,可更新只有到这一步(拿到文件清单)才算得出来。 -->
                        <Border Padding="6,1" CornerRadius="4" Background="#FF107C10"
                                Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock FontSize="10" Foreground="White"
                                       l:Uids.Uid="ModStore_Detail_Installed" Text="已安装" />
                        </Border>
                        <Border Padding="6,1" CornerRadius="4" Background="#FF0078D4"
                                Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock FontSize="10" Foreground="White"
                                       l:Uids.Uid="ModStore_Detail_Updatable" Text="可更新" />
                        </Border>
                    </StackPanel>

                    <!-- 标签页 -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="OverviewTabBtn" FontSize="13" FontWeight="SemiBold"
                                Background="Transparent" BorderThickness="0" Height="36"
                                Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                HorizontalAlignment="Stretch" Click="OverviewTab_Click"
                                l:Uids.Uid="ModStore_Detail_OverviewTab" Content="总览与文件" />
                        <Button Grid.Column="1" x:Name="DescriptionTabBtn" FontSize="13"
                                Background="Transparent" BorderThickness="0" Height="36"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                HorizontalAlignment="Stretch" Click="DescriptionTab_Click"
                                l:Uids.Uid="ModStore_Detail_DescriptionTab" Content="图文描述" />
                    </Grid>

                    <!-- 总览 -->
                    <StackPanel x:Name="OverviewContent" Spacing="14">

                        <!-- 补详情期间 -->
                        <StackPanel Orientation="Horizontal" Spacing="8"
                                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ProgressRing IsActive="True" Width="18" Height="18" />
                            <TextBlock FontSize="12" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       l:Uids.Uid="ModStore_Detail_Loading" Text="正在加载详情…" />
                        </StackPanel>

                        <!-- 详情失败:原因 + 重试 -->
                        <Border Padding="12,10" CornerRadius="8" Background="#18FF4D4F"
                                BorderBrush="#40FF4D4F" BorderThickness="0.5"
                                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding ErrorMessage}" FontSize="12" TextWrapping="Wrap" />
                                <Button HorizontalAlignment="Left" CornerRadius="6"
                                        Click="RetryButton_Click"
                                        l:Uids.Uid="ModStore_Detail_Retry" Content="重试" />
                            </StackPanel>
                        </Border>

                        <!-- 截图画廊(在代码里搭:与市场侧同样的 BitmapImage 用法) -->
                        <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="GalleryPanel" Orientation="Horizontal" Spacing="8" />
                        </ScrollViewer>

                        <!-- 一句话简介 -->
                        <TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap"
                                   LineHeight="19"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <!-- 文件清单 -->
                        <TextBlock FontSize="14" FontWeight="SemiBold"
                                   l:Uids.Uid="ModStore_Detail_FilesTitle" Text="文件" />
                        <TextBlock FontSize="12" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="{Binding HasNoFiles, Converter={StaticResource BoolToVisibilityConverter}}"
                                   l:Uids.Uid="ModStore_Detail_NoFiles"
                                   Text="这个 mod 没有可下载的文件（作者可能已经撤下）。" />
                        <ListView x:Name="FilesList" SelectionMode="Single"
                                  ItemTemplate="{StaticResource ModStoreFileTemplate}"
                                  ItemsSource="{Binding Files}"
                                  SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                                  Visibility="{Binding HasFiles, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,4" />
                                    <Setter Property="CornerRadius" Value="6" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>

                        <!-- 下载**选中的那个**文件：多文件时由用户在上面自己挑(PRD 的要求，不自动挑)，
                             这里只负责把挑中的交给下载队列。没有文件时按钮与清单一起收起 ——
                             清单非空时 SelectedFile 一定有值(ApplyDetail 默认选中第一个活跃文件)。

                             已装且有新版时换个说法(「更新到最新版本」)：底下走的是同一条路，
                             只是部署时会被就地更新到原来那一份上(见 ModStoreDeploymentService.ResolveModToUpdate)，
                             而预选文件在 ApplyInstallStatus 里已经换成了判定所指的那个最新文件。 -->
                        <Button x:Name="DownloadButton" HorizontalAlignment="Stretch"
                                CornerRadius="6" Click="DownloadButton_Click"
                                Visibility="{Binding HasFiles, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="13" Glyph="&#xE896;" />
                                <TextBlock FontSize="12"
                                           l:Uids.Uid="ModStore_Detail_Download" Text="下载选中文件"
                                           Visibility="{Binding IsNotUpdatable, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <TextBlock FontSize="12"
                                           l:Uids.Uid="ModStore_Detail_Update" Text="更新到最新版本"
                                           Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- 图文描述 -->
                    <ScrollViewer x:Name="DescriptionContent" Visibility="Collapsed">
                        <StackPanel Spacing="10">
                            <TextBlock x:Name="BodyText" Text="{Binding Body}" FontSize="13"
                                       TextWrapping="Wrap" LineHeight="20"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock FontSize="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Visibility="{Binding HasNoBody, Converter={StaticResource BoolToVisibilityConverter}}"
                                       l:Uids.Uid="ModStore_Detail_NoBody" Text="作者没有提供文字描述。" />
                        </StackPanel>
                    </ScrollViewer>

                    <Rectangle Height="14" />

                    <!-- 原页面:商店里能看到的终究是转载过来的信息,给一条回到源头的路 -->
                    <Button x:Name="OpenInBrowserButton" HorizontalAlignment="Stretch"
                            CornerRadius="6" Click="OpenInBrowser_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="13" Glyph="&#xE774;" />
                            <TextBlock FontSize="12"
                                       l:Uids.Uid="ModStore_Detail_OpenInBrowser" Text="查看 GameBanana 页面" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 灯箱 -->
        <Grid x:Name="Lightbox" Grid.ColumnSpan="2" Visibility="Collapsed"
              Background="#E0000000" Tapped="LightboxBg_Tapped">
            <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="16" Padding="8,4" Background="#40000000"
                    BorderThickness="0" CornerRadius="4" Click="LightboxClose_Click">
                <FontIcon FontSize="16" Glyph="&#xE711;" Foreground="White" />
            </Button>
            <Image x:Name="LightboxImage" MaxWidth="1000" MaxHeight="750"
                   Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>
