<?xml version="1.0" encoding="utf-8" ?>
<winUiEx:WindowEx
    x:Class="GIMI_ModManager.WinUI.Views.Overlay.ScreenshotRegionSelectorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:winUiEx="using:WinUIEx">

    <!--  先抓整屏、再把整屏显示出来让用户框 —— 不做透明窗口。
          理由：WinUI 3 的透明窗口要额外处理合成与 DPI，而「把抓到的图当底图」天然就是
          用户按下截图那一刻的画面，也保证框选遮罩不会混进最终截图里。  -->
    <Grid
        x:Name="RootGrid"
        Background="Black"
        KeyDown="OnKeyDown"
        PointerMoved="OnPointerMoved"
        PointerPressed="OnPointerPressed"
        PointerReleased="OnPointerReleased"
        PointerCanceled="OnPointerCanceled"
        RightTapped="OnRightTapped">
        <!--  焦点落在它身上，Esc 才有机会进到 KeyDown：Grid 自己不可聚焦  -->
        <Button
            x:Name="FocusSink"
            Width="1"
            Height="1"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            IsTabStop="True"
            Opacity="0" />

        <Image x:Name="BackgroundImage" Stretch="Fill" />

        <!--  整屏压暗  -->
        <Border Background="#66000000" />

        <!--  选中的那块把原图再盖回去一次，形成「挖洞」效果；Clip 在代码里跟着框走  -->
        <Image x:Name="BrightImage" Stretch="Fill">
            <Image.Clip>
                <RectangleGeometry x:Name="BrightClip" />
            </Image.Clip>
        </Image>

        <Border
            x:Name="SelectionBorder"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            BorderBrush="#FFE8A33D"
            BorderThickness="2"
            Visibility="Collapsed" />

        <Border
            Margin="0,24,0,0"
            Padding="12,6"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Background="#AA000000"
            CornerRadius="4">
            <TextBlock
                FontSize="13"
                Foreground="White"
                Text="拖动框选截图区域 · Esc 取消" />
        </Border>
    </Grid>
</winUiEx:WindowEx>
