<?xml version="1.0" encoding="utf-8" ?>
<winUiEx:WindowEx
    x:Class="GIMI_ModManager.WinUI.Views.Overlay.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:coreHelpers="using:GIMI_ModManager.Core.Entities.Mods.Helpers"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:l="using:WinUI3Localizer"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:overlayVm="using:GIMI_ModManager.WinUI.ViewModels.Overlay"
    xmlns:winUiEx="using:WinUIEx"
    x:Name="RootWindow"
    mc:Ignorable="d">

    <!--  RequestedTheme="Dark" 是**必须**的，不是审美偏好：底下的面板是深色的，而 ComboBox/TextBox/ListViewItem
          里那些没显式写颜色的文字（角色名、Mod 名、下拉项）取的是主题默认前景色。跟随浅色主题时它们是黑的，
          压在近黑的底上就是「字都看不清」。钉死 Dark 之后这些默认前景才会是浅色。  -->
    <Page RequestedTheme="Dark">
        <Page.Resources>
            <!--  拖拽安装那行进度区的进场动画：淡入 + 从下方 8 像素滑上来。
                  只做「进来」这一次 —— 拖一下之后立刻有东西滑出来，是「收到了、正在办」的最短表达。

                  用 RenderTransform 而不是 UIElement.Translation：前者是老写法、兼容性没得挑，
                  动的只是这一行自己，不会牵动布局。  -->
            <Storyboard x:Name="InstallStatusInStoryboard">
                <DoubleAnimation
                    Storyboard.TargetName="InstallStatusRow"
                    Storyboard.TargetProperty="Opacity"
                    Duration="0:0:0.18"
                    From="0"
                    To="1" />
                <DoubleAnimation
                    Storyboard.TargetName="InstallStatusRow"
                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                    Duration="0:0:0.22"
                    From="8"
                    To="0">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
        </Page.Resources>
        <!--  背景刻意不透明（不是 Mica/亚克力）：浮窗压在游戏画面上，半透明会让文字糊进背景里读不清。
              描边也是为可读性服务的：亮色游戏画面里，没有描边的深色块边界会糊成一片。

              AllowDrop/拖拽那两个事件：把包直接拖到浮窗上就能装 —— 装给**当前选中的角色**
              （浮窗本来就只对着一个角色）。判定与动作在 OverlayWindow.xaml.cs 与
              OverlayViewModel.DropModPackageAsync。  -->
        <Grid
            x:Name="RootGrid"
            AllowDrop="True"
            DragOver="RootGrid_OnDragOver"
            Drop="RootGrid_OnDrop"
            Background="#FF101016"
            BorderBrush="#40FFFFFF"
            BorderThickness="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  拖动条：整条都能拖窗口（无边框窗口没有标题栏可拖，拖出屏幕外就再也抓不回来了）。
                  关闭按钮放在这一层里，它会把 PointerPressed 标记为已处理，所以点它**不会**顺带开始拖动 —— 正是想要的。  -->
            <Grid
                x:Name="DragStrip"
                Grid.Row="0"
                Height="38"
                Background="Transparent"
                PointerCaptureLost="OnDragStripPointerCaptureLost"
                PointerMoved="OnDragStripPointerMoved"
                PointerPressed="OnDragStripPointerPressed"
                PointerReleased="OnDragStripPointerReleased">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Text="Skin Switcher"
                    l:Uids.Uid="Overlay_Title" />

                <!--  热键名由 OverlayWindowService 在窗口建好后填进来（它才知道注册到了哪个键）。
                      不写死：候选键会因为被别的程序占用而退到备选，写死了就会骗用户。  -->
                <TextBlock
                    x:Name="HotkeyHintText"
                    Grid.Column="1"
                    MaxWidth="96"
                    Margin="8,0,6,0"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="#C8FFFFFF"
                    TextTrimming="CharacterEllipsis" />

                <!--  浮窗大小：小 / 中 / 大。下拉框放标题条里，切换会持久化。
                      宽度压到 50 左右，给右边的截图按钮与关闭键留位置。  -->
                <ComboBox
                    x:Name="SizeComboBox"
                    Grid.Column="2"
                    Width="64"
                    MinWidth="0"
                    Padding="6,2,0,2"
                    Margin="0,0,4,0"
                    VerticalAlignment="Center"
                    FontSize="10"
                    DisplayMemberPath="DisplayName"
                    ItemsSource="{x:Bind ViewModel.SizeOptions}"
                    SelectedIndex="{x:Bind ViewModel.SelectedSizeIndex, Mode=TwoWay}"
                    ToolTipService.ToolTip="浮窗大小" />

                <!--  框选截图 / 按上次区域截图。放在标题条里而不是另起一行：
                      浮窗只有 360 高，每一行都要留给 Mod 列表。  -->
                <Button
                    x:Name="CaptureRegionButton"
                    Grid.Column="3"
                    Margin="0,0,2,0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnCaptureRegionClick"
                    ToolTipService.ToolTip="框选截图（会记住这次区域）">
                    <FontIcon FontSize="12" Glyph="&#xE722;" />
                </Button>

                <Button
                    x:Name="CaptureLastRegionButton"
                    Grid.Column="4"
                    Margin="0,0,2,0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnCaptureLastRegionClick"
                    ToolTipService.ToolTip="按上次区域截图（全局热键 Ctrl+Alt+S）">
                    <FontIcon FontSize="12" Glyph="&#xE8EE;" />
                </Button>

                <Button
                    x:Name="HideButton"
                    Grid.Column="5"
                    Margin="0,0,6,0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnHideClick">
                    <FontIcon FontSize="12" Glyph="&#xE711;" />
                </Button>
            </Grid>

            <!--  页签：Mod 切换 / 修复。单独占一行而不是塞进拖动条 ——
                  拖动条整条挂着 PointerPressed，可点控件冒泡上去会顺带开始拖窗；
                  而且小档 380 宽时标题条已经被尺寸下拉、两个截图键、关闭键占满了。  -->
            <controls:Segmented
                Grid.Row="1"
                Margin="10,0,10,6"
                HorizontalAlignment="Stretch"
                IsEnabled="{x:Bind ViewModel.CanSwitchTabs, Mode=OneWay}"
                SelectedIndex="{x:Bind ViewModel.ActiveTabIndex, Mode=TwoWay}"
                SelectionMode="Single">
                <controls:SegmentedItem Content="Mod 切换" l:Uids.Uid="Overlay_TabMods" />
                <controls:SegmentedItem Content="修复" l:Uids.Uid="Overlay_TabFix" />
            </controls:Segmented>

            <ComboBox
                Grid.Row="2"
                Margin="12,0,12,8"
                HorizontalAlignment="Stretch"
                IsEnabled="{x:Bind ViewModel.CanSwitchCharacter, Mode=OneWay}"
                ItemsSource="{x:Bind ViewModel.Characters}"
                SelectedItem="{x:Bind ViewModel.SelectedCharacter, Mode=TwoWay}">
                <!--  头像 + 名字。DisplayMemberPath 与 ItemTemplate 互斥（同时给会抛异常），要头像就只能改用模板。
                      ComboBox 收起时显示选中项也走这个模板，所以闭着的时候一样能看到头像。  -->
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="overlayVm:OverlayCharacterItem">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <!--  只钉高度、不钉宽度：角色立绘是长条图，钉成正方形会把脸裁掉或者压扁。
                                  DecodePixelHeight 按显示高度的两倍给（留给高 DPI），既不糊也不至于白解一张大图。  -->
                            <Image Height="22">
                                <Image.Source>
                                    <BitmapImage DecodePixelHeight="44" UriSource="{x:Bind ImageUri}" />
                                </Image.Source>
                            </Image>
                            <TextBlock VerticalAlignment="Center" Text="{x:Bind DisplayName}" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBox
                Grid.Row="3"
                Margin="12,0,12,8"
                PlaceholderText="Search mods"
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Visibility="{x:Bind ViewModel.IsModTabActive, Mode=OneWay}"
                l:Uids.Uid="Overlay_SearchPlaceholder" />

            <!--  模式 + 手动刷新。模式决定"勾了之后什么时候刷"：
                  单选（默认）= 勾一下就自动刷，且同角色只留一件；多选 = 攒着，等这里的刷新按钮。
                  刷新按钮在单选模式下也留着 —— 刷新失败之后它是唯一的重试入口，
                  不然用户为了重试还得去动某个 Mod 的勾。
                  单独占一行而不是挤在搜索框右边：俄语「Несколько」这类长词会把搜索框挤到没法用。  -->
            <Grid
                Grid.Row="4"
                Margin="12,0,12,8"
                ColumnSpacing="8"
                Visibility="{x:Bind ViewModel.IsModTabActive, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  SelectedIndex 双向绑定：序号 ↔ 模式的换算只在 ViewModel 里一处（见 ModeIndex 注释）  -->
                <controls:Segmented
                    Grid.Column="0"
                    SelectedIndex="{x:Bind ViewModel.ModeIndex, Mode=TwoWay}"
                    SelectionMode="Single">
                    <controls:SegmentedItem Content="单选" l:Uids.Uid="Overlay_ModeSingle" />
                    <controls:SegmentedItem Content="多选" l:Uids.Uid="Overlay_ModeMulti" />
                </controls:Segmented>

                <!--  有改动没刷时亮个点：多选模式把"什么时候刷"交给了用户，就得有人提醒他还欠一次刷新。
                      单选模式下这个点永远不会亮 —— 勾完就刷掉了。  -->
                <Ellipse
                    Grid.Column="2"
                    Width="6"
                    Height="6"
                    VerticalAlignment="Center"
                    Fill="#FFE8A33D"
                    Visibility="{x:Bind ViewModel.HasPendingChanges, Mode=OneWay}" />

                <Button
                    Grid.Column="3"
                    Command="{x:Bind ViewModel.RefreshNowCommand}"
                    Content="刷新"
                    IsEnabled="{x:Bind ViewModel.RefreshCoordinator.CanRequestRefresh, Mode=OneWay}"
                    l:Uids.Uid="Overlay_RefreshNow" />
            </Grid>

            <!--  状态区：刷新那边的成败（协调器）与勾选失败（ViewModel）各占一行，
                  都为空时这两行自己塌掉，不占地方。  -->
            <StackPanel
                Grid.Row="5"
                Margin="12,0,12,6"
                Spacing="2"
                Visibility="{x:Bind ViewModel.IsModTabActive, Mode=OneWay}">
                <!--  拖拽安装的进度行：转圈（解压 / 落盘）→ 换成绿勾（装好了）。
                      与下面那些状态行同一套排法（图标对齐顶部、文字用 * 列拿真实剩余宽度），
                      只是这一行由 ViewModel 直接控制显隐与文案。  -->
                <Grid
                    x:Name="InstallStatusRow"
                    ColumnSpacing="6"
                    Visibility="{x:Bind ViewModel.ShowInstallStatus, Mode=OneWay}">
                    <Grid.RenderTransform>
                        <TranslateTransform />
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  转圈与绿勾互斥地占同一格：装完那一下就是「转圈变对勾」，不必再做一次过渡。  -->
                    <ProgressRing
                        Grid.Column="0"
                        Width="14"
                        Height="14"
                        Margin="0,1,0,0"
                        VerticalAlignment="Top"
                        IsActive="{x:Bind ViewModel.IsInstalling, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsInstalling, Mode=OneWay}" />
                    <FontIcon
                        Grid.Column="0"
                        Margin="0,1,0,0"
                        VerticalAlignment="Top"
                        FontSize="12"
                        Foreground="#FF6CCB5F"
                        Glyph="&#xE73E;"
                        Visibility="{x:Bind ViewModel.ShowInstallSuccess, Mode=OneWay}" />

                    <TextBlock
                        Grid.Column="1"
                        FontSize="11"
                        Foreground="#E6FFFFFF"
                        Text="{x:Bind ViewModel.InstallStatusText, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                </Grid>

                <!--  删除成功后的绿色状态行（失败走 ErrorMessage 的琥珀色）。  -->
                <TextBlock
                    FontSize="11"
                    Foreground="#FF6CCB5F"
                    Text="{x:Bind ViewModel.DeleteStatusMessage, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.HasDeleteStatus, Mode=OneWay}" />

                <!--  图标 + 文字用 Grid 而不是横向 StackPanel：StackPanel 给子元素的可用宽度是"无限"，
                      于是文字的 TextWrapping="Wrap" 永远等不到该换行的宽度 —— 实测长文案（"提权助手没在运行…"）
                      就这样被窗口右边缘硬生生切掉。Grid 的 * 列才会把真实剩余宽度交给 TextBlock。  -->
                <Grid ColumnSpacing="6" Visibility="{x:Bind ViewModel.HasRefreshStatus, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  图标一律对齐顶（不是居中）：文字换行后会有第二行，居中的图标会飘到两行之间，
                          而它标记的是"这一条状态"，理应贴着第一行。  -->
                    <ProgressRing
                        Grid.Column="0"
                        Width="14"
                        Height="14"
                        Margin="0,1,0,0"
                        VerticalAlignment="Top"
                        IsActive="{x:Bind ViewModel.RefreshCoordinator.IsRefreshing, Mode=OneWay}" />
                    <FontIcon
                        Grid.Column="1"
                        Margin="0,1,0,0"
                        VerticalAlignment="Top"
                        FontSize="12"
                        Foreground="#FF6CCB5F"
                        Glyph="&#xE73E;"
                        Visibility="{x:Bind ViewModel.RefreshCoordinator.ShowSuccessIcon, Mode=OneWay}" />
                    <FontIcon
                        Grid.Column="2"
                        Margin="0,1,0,0"
                        VerticalAlignment="Top"
                        FontSize="12"
                        Foreground="#FFE8A33D"
                        Glyph="&#xE7BA;"
                        Visibility="{x:Bind ViewModel.RefreshCoordinator.ShowFailureIcon, Mode=OneWay}" />
                    <TextBlock
                        Grid.Column="3"
                        FontSize="11"
                        Foreground="#E6FFFFFF"
                        Text="{x:Bind ViewModel.RefreshCoordinator.StatusMessage, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </Grid>

                <!--  「已标记 N 个 · 右键可标记 / 取消」。用中性灰而不是下面那两种橙色：
                      它不是错误也不是提权告警，只是"这一轮审到哪儿了"的计数。  -->
                <TextBlock
                    FontSize="11"
                    Foreground="#B3FFFFFF"
                    Text="{x:Bind ViewModel.MarkedSummary, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.HasMarks, Mode=OneWay}" />

                <!--  「已看过 N 个 · 中键可标记 / 取消」。与 NSFW 那条并列，提醒手势怎么用。  -->
                <TextBlock
                    FontSize="11"
                    Foreground="#B3FFFFFF"
                    Text="{x:Bind ViewModel.SeenSummary, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.HasSeenMarks, Mode=OneWay}" />

                <!--
                    截图结果两条：成功（绿色，与安装成功同一个色值）与 取消/失败（琥珀色，与 ErrorMessage 同色）。
                    以前共用一条绿色的，截图失败在界面上看起来像办成了。
                -->
                <TextBlock
                    FontSize="11"
                    Foreground="#FF6CCB5F"
                    Text="{x:Bind ViewModel.ScreenshotStatusMessage, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.HasScreenshotSuccess, Mode=OneWay}" />
                <TextBlock
                    FontSize="11"
                    Foreground="#FFE8A33D"
                    Text="{x:Bind ViewModel.ScreenshotStatusMessage, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.HasScreenshotProblem, Mode=OneWay}" />

                <TextBlock
                    FontSize="11"
                    Foreground="#FFE8A33D"
                    Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.HasErrorMessage, Mode=OneWay}" />

                <!--  提权时的常驻提示。它必须常驻：UIPI 会在 OLE 层把跨完整性级别的拖拽整个掐掉，
                      连 DragOver 都不会触发 —— 所以上面那条"拖拽时才写"的状态行在这里永远等不到机会。
                      用户能看到的只有禁止光标，这句话是浮窗上唯一能告诉他原因的东西。  -->
                <TextBlock
                    FontSize="11"
                    Foreground="#FFE8A33D"
                    Text="{x:Bind ViewModel.ElevationNotice, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.HasElevationNotice, Mode=OneWay}" />
            </StackPanel>

            <!--  x:Name 是给代码后置用的：键盘选中换行时要把那一行滚进视野，
                  而列表通常比窗口高，选中的行可能整行都在屏幕外。  -->
            <ListView
                x:Name="ModList"
                Grid.Row="6"
                Margin="6,0,6,8"
                ItemsSource="{x:Bind ViewModel.Mods}"
                SelectionMode="None"
                Visibility="{x:Bind ViewModel.IsModTabActive, Mode=OneWay}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Padding" Value="4,2" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="overlayVm:OverlayModItemViewModel">
                        <!--  行 + 它自己的按键面板。面板不是浮窗底部的全局块：
                              只有当前唯一勾选的那一行才显示，勾选换人它就跟着换行。  -->
                        <StackPanel>
                            <!--  Tag 上挂的是这一行自己，右键处理器从它取回 VM（模板里 x:Bind 的
                                  DataContext 是行 VM，Tag 只是把它交给代码后置的一种不依赖 DataContext 的拿法）。
                                  RightTapped 打在**整行**上：左键落在勾选框上换装、右键落在行上打标，
                                  两个手势各走各的，不会互相抢。  -->
                            <Grid
                                ColumnSpacing="8"
                                PointerPressed="OnModRowPointerPressed"
                                RightTapped="OnModRowRightTapped"
                                Tag="{x:Bind}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!--  键盘选中行的高亮：铺在最底层（先声明的在下层），横跨三列、不参与布局。
                                  负外边距是为了盖住 ListViewItem 的 Padding(4,2)，让底色顶到行的边上。
                                  用 Visibility 而不是条件改 Background：WinUI 没有 DataTrigger，
                                  为两态去写转换器或 VisualState 都不如一层可显隐的底直白。  -->
                            <Border
                                Grid.Column="0"
                                Grid.ColumnSpan="7"
                                Margin="-4,-2"
                                Background="#33FFFFFF"
                                BorderBrush="#FFE8A33D"
                                BorderThickness="2,0,0,0"
                                CornerRadius="3"
                                Visibility="{x:Bind IsSelected, Mode=OneWay}" />

                            <!--  CheckBox 的 Command 落在行自己身上：每个行一个命令实例，
                                  所以"同一个 Mod 连点"被挡住、不同行之间互不阻塞。
                                  IsChecked 是单向绑的，切换失败时由行自己重新推一次真实值（见 RefreshEnabledState）。  -->
                            <CheckBox
                                Grid.Column="0"
                                MinWidth="0"
                                Command="{x:Bind ToggleModCommand}"
                                IsChecked="{x:Bind IsEnabled, Mode=OneWay}" />

                            <!--  缩略图。用 BitmapImage + UriSource：由 WinUI 自己异步解码，
                                  只在行被虚拟化出来时才加载，不需要外面再搭一套懒加载。
                                  DecodePixelWidth 是原图可能是 4K 截图，不限制就白解一张大图。  -->
                            <Image
                                Grid.Column="1"
                                Width="40"
                                Height="40"
                                Stretch="UniformToFill">
                                <Image.Source>
                                    <BitmapImage DecodePixelWidth="80" UriSource="{x:Bind ImagePath}" />
                                </Image.Source>
                            </Image>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock
                                    MaxLines="1"
                                    Text="{x:Bind Name}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="#B3FFFFFF"
                                    MaxLines="1"
                                    Text="{x:Bind Author}"
                                    TextTrimming="CharacterEllipsis"
                                    Visibility="{x:Bind HasAuthor}" />
                            </StackPanel>

                            <!--  右键打上的 NSFW 红标。用实心红底 + 白字而不是换个图标：
                                  这件 Mod 的名字多半就是露骨的那几个字，扫一眼列表时要能立刻把
                                  「已经判过的」和「还没看的」分开，颜色比图标快。  -->
                            <Border
                                Grid.Column="3"
                                Padding="6,1"
                                VerticalAlignment="Center"
                                Background="#FFC62828"
                                CornerRadius="3"
                                Visibility="{x:Bind IsMarked, Mode=OneWay}">
                                <TextBlock
                                    FontSize="10"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="NSFW" />
                            </Border>

                            <!--  中键打的「已看过」记号。用绿色对勾而不是再加一块文字徽章：
                                  红标（要下架）与绿勾（看过了）是两类信息，颜色 + 形状一眼能分开，
                                  也不跟长 Mod 名抢宽度。  -->
                            <FontIcon
                                Grid.Column="4"
                                Margin="0,0,2,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="#FF6CCB5F"
                                Glyph="&#xE73E;"
                                ToolTipService.ToolTip="已看过（中键标记 / 取消）"
                                Visibility="{x:Bind IsSeen, Mode=OneWay}" />

                            <!--  单选模式下的「下一个」：只出现在当前勾选行、且后面还有一行时。
                                  点它 = 勾上下一件（当前的自动收起，并触发 F10 刷新），
                                  是"一件件往下审"最短的一步。  -->
                            <Button
                                Grid.Column="5"
                                MinWidth="0"
                                MinHeight="0"
                                Margin="0,0,0,0"
                                Padding="6,2"
                                FontSize="10"
                                Click="OnNextModClick"
                                Content="下一个"
                                Tag="{x:Bind}"
                                ToolTipService.ToolTip="勾选下一件 Mod（当前这件会自动收起）"
                                Visibility="{x:Bind ShowNextButton, Mode=OneWay}" />

                            <!--  删除：整件 Mod 文件夹移至 Windows 回收站。常驻显示，小档也放得下；
                                  点击只弹浮窗内的确认卡，不直接动盘。  -->
                            <Button
                                Grid.Column="6"
                                MinWidth="0"
                                MinHeight="0"
                                Margin="2,0,0,0"
                                Padding="5,2"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="OnDeleteModClick"
                                Tag="{x:Bind}"
                                ToolTipService.ToolTip="删除 Mod（移至回收站）">
                                <FontIcon
                                    FontSize="12"
                                    Foreground="#FFE06A6A"
                                    Glyph="&#xE74D;" />
                            </Button>
                            </Grid>

                            <!--  行内按键映射。只有唯一勾选的那一行显示（IsKeyPanelVisible）；
                                  标题行点一下折叠 / 展开。放在行下面而不是浮窗底部，是为了让
                                  「这一件 Mod 有哪些按键」与 Mod 本身贴在一起看。  -->
                            <Border
                                Margin="72,2,0,4"
                                Padding="8,4"
                                Background="#1AFFFFFF"
                                BorderBrush="#33FFFFFF"
                                BorderThickness="1"
                                CornerRadius="4"
                                Visibility="{x:Bind IsKeyPanelVisible, Mode=OneWay}">
                                <StackPanel Spacing="4">
                                    <Button
                                        Padding="0"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="{x:Bind ToggleKeyPanel}"
                                        ToolTipService.ToolTip="折叠 / 展开按键映射">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Foreground="#E6FFFFFF"
                                                Text="按键映射" />
                                            <FontIcon
                                                Grid.Column="1"
                                                FontSize="9"
                                                Foreground="#99FFFFFF"
                                                Glyph="{x:Bind KeyPanelChevronGlyph, Mode=OneWay}" />
                                        </Grid>
                                    </Button>

                                    <StackPanel Spacing="4" Visibility="{x:Bind IsKeyPanelExpanded, Mode=OneWay}">
                                        <ProgressRing
                                            Width="16"
                                            Height="16"
                                            HorizontalAlignment="Left"
                                            IsActive="{x:Bind IsKeyBindingLoading, Mode=OneWay}"
                                            Visibility="{x:Bind IsKeyBindingLoading, Mode=OneWay}" />

                                        <TextBlock
                                            FontSize="10"
                                            Foreground="#B3FFFFFF"
                                            Text="{x:Bind KeyPanelEmptyMessage, Mode=OneWay}"
                                            TextWrapping="Wrap" />

                                        <ItemsRepeater ItemsSource="{x:Bind KeyBindingGroups, Mode=OneWay}">
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="coreHelpers:ModIniKeyBindingGroup">
                                                    <StackPanel Margin="0,0,0,2" Spacing="2">
                                                        <!--  ini 文件分组头：点一下折叠  -->
                                                        <Button
                                                            Padding="0"
                                                            HorizontalAlignment="Left"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Click="{x:Bind ToggleExpanded}">
                                                            <TextBlock
                                                                FontSize="9"
                                                                Foreground="#99FFFFFF"
                                                                Text="{x:Bind ShortPath}" />
                                                        </Button>

                                                        <ItemsRepeater
                                                            ItemsSource="{x:Bind Bindings}"
                                                            Visibility="{x:Bind IsExpanded, Mode=OneWay}">
                                                            <ItemsRepeater.ItemTemplate>
                                                                <DataTemplate x:DataType="coreHelpers:ModIniKeyBindingEntry">
                                                                    <Grid Margin="0,1" ColumnSpacing="8">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>

                                                                        <StackPanel VerticalAlignment="Center">
                                                                            <TextBlock
                                                                                FontSize="11"
                                                                                Foreground="#E6FFFFFF"
                                                                                Text="{x:Bind DisplayLabel}"
                                                                                TextTrimming="CharacterEllipsis" />
                                                                            <TextBlock
                                                                                FontSize="9"
                                                                                Foreground="#80FFFFFF"
                                                                                Text="{x:Bind Description}"
                                                                                TextTrimming="CharacterEllipsis" />
                                                                        </StackPanel>

                                                                        <Button
                                                                            Grid.Column="1"
                                                                            MinWidth="0"
                                                                            MinHeight="0"
                                                                            Padding="7,1"
                                                                            Click="OnKeyBadgeClick"
                                                                            Content="{x:Bind KeyValue}"
                                                                            IsEnabled="{x:Bind CanSendKey}"
                                                                            Tag="{x:Bind}"
                                                                            ToolTipService.ToolTip="点击把这个按键发给游戏" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsRepeater.ItemTemplate>
                                                        </ItemsRepeater>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock
                Grid.Row="6"
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="#B3FFFFFF"
                IsHitTestVisible="False"
                Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.ShowModListEmpty, Mode=OneWay}" />

            <!--  ───────── 修复页 ─────────
                  与 ModList 同一行互斥显示。整页放 ScrollViewer：大档 520×660 在 1366×768 上也可能被
                  KeepOnScreen 夹矮，用户切到小/中档时更需要滚动到主按钮与底栏。  -->
            <ScrollViewer
                Grid.Row="6"
                Margin="10,0,10,8"
                VerticalScrollBarVisibility="Auto"
                Visibility="{x:Bind ViewModel.IsFixTabActive, Mode=OneWay}">
                <StackPanel Spacing="8">
                    <controls:Segmented
                        HorizontalAlignment="Stretch"
                        SelectedIndex="{x:Bind ViewModel.FixSubTabIndex, Mode=TwoWay}"
                        SelectionMode="Single">
                        <controls:SegmentedItem Content="一键修复" l:Uids.Uid="Overlay_FixSubRepair" />
                        <controls:SegmentedItem Content="备份回滚" l:Uids.Uid="Overlay_FixSubRollback" />
                    </controls:Segmented>

                    <!--  ── 修复视图 ──  -->
                    <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.IsFixViewActive, Mode=OneWay}">
                        <TextBlock
                            FontSize="12"
                            Foreground="#E6FFFFFF"
                            Text="{x:Bind ViewModel.FixScopeText, Mode=OneWay}"
                            TextWrapping="Wrap" />

                        <TextBlock
                            FontSize="11"
                            Foreground="#B3FFFFFF"
                            Text="先在「Mod 切换」页选择角色，或该角色暂无 Mod。"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.HasNoFixTargets, Mode=OneWay}" />

                        <Grid ColumnSpacing="6" Visibility="{x:Bind ViewModel.HasFixTargets, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button
                                HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.ToggleFixTargetListCommand}"
                                Content="{x:Bind ViewModel.FixTargetListToggleText, Mode=OneWay}"
                                FontSize="11" />
                            <Button
                                Grid.Column="1"
                                Command="{x:Bind ViewModel.SelectAllFixTargetsCommand}"
                                Content="全选"
                                FontSize="11"
                                IsEnabled="{x:Bind ViewModel.CanEditFixOptions, Mode=OneWay}" />
                            <Button
                                Grid.Column="2"
                                Command="{x:Bind ViewModel.DeselectAllFixTargetsCommand}"
                                Content="全不选"
                                FontSize="11"
                                IsEnabled="{x:Bind ViewModel.CanEditFixOptions, Mode=OneWay}" />
                        </Grid>

                        <ListView
                            MaxHeight="150"
                            ItemsSource="{x:Bind ViewModel.FixTargets}"
                            SelectionMode="None"
                            Visibility="{x:Bind ViewModel.IsFixTargetListExpanded, Mode=OneWay}">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="Padding" Value="4,1" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="overlayVm:OverlayFixTargetItem">
                                    <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock FontSize="12" Text="{x:Bind Name}" />
                                            <TextBlock
                                                FontSize="10"
                                                Foreground="#99FFFFFF"
                                                Text="已禁用"
                                                VerticalAlignment="Center"
                                                Visibility="{x:Bind ShowDisabledHint}" />
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!--  开关。互斥由 ViewModel 兜底（两个都存成 true 时也只生效一个）。  -->
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="1">
                                <TextBlock FontSize="12" Text="补全贴图状态" l:Uids.Uid="Overlay_FixDerived" />
                                <TextBlock
                                    FontSize="10"
                                    Foreground="#99FFFFFF"
                                    Text="为缺状态的贴图补哈希（坎特蕾拉湿身、千咲强化 E 等）"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="1"
                                MinWidth="0"
                                OffContent=""
                                OnContent=""
                                IsEnabled="{x:Bind ViewModel.CanEditFixOptions, Mode=OneWay}"
                                IsOn="{x:Bind ViewModel.FixDerivedHashes, Mode=TwoWay}" />
                        </Grid>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="1">
                                <TextBlock FontSize="12" Text="应用稳定纹理" l:Uids.Uid="Overlay_FixStable" />
                                <TextBlock
                                    FontSize="10"
                                    Foreground="#99FFFFFF"
                                    Text="需安装最新 RabbitFX（目前仅部分角色）"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="1"
                                MinWidth="0"
                                OffContent=""
                                OnContent=""
                                IsEnabled="{x:Bind ViewModel.CanEditFixOptions, Mode=OneWay}"
                                IsOn="{x:Bind ViewModel.FixStableTexture, Mode=TwoWay}" />
                        </Grid>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="1">
                                <TextBlock FontSize="12" Text="模组破洞/部位缺失修复" l:Uids.Uid="Overlay_FixRendering33" />
                                <TextBlock
                                    FontSize="10"
                                    Foreground="#FFE8A33D"
                                    Text="仅在模组出现身体部位缺失或破洞时开启！"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="1"
                                MinWidth="0"
                                OffContent=""
                                OnContent=""
                                IsEnabled="{x:Bind ViewModel.CanEditFixOptions, Mode=OneWay}"
                                IsOn="{x:Bind ViewModel.FixRendering33, Mode=TwoWay}" />
                        </Grid>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="1">
                                <TextBlock FontSize="12" Text="修复爱弥斯机兵形态的模型异常" l:Uids.Uid="Overlay_FixAemeath" />
                                <TextBlock
                                    FontSize="10"
                                    Foreground="#99FFFFFF"
                                    Text="正常的爱弥斯机兵模组不要开启，也不要重复修复"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="1"
                                MinWidth="0"
                                OffContent=""
                                OnContent=""
                                IsEnabled="{x:Bind ViewModel.CanEditFixOptions, Mode=OneWay}"
                                IsOn="{x:Bind ViewModel.FixAemeathMech, Mode=TwoWay}" />
                        </Grid>

                        <StackPanel Spacing="4">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="1">
                                    <TextBlock FontSize="12" Text="女漂-风主形态眼部修复" l:Uids.Uid="Overlay_FixAero" />
                                    <TextBlock
                                        FontSize="10"
                                        Foreground="#FFE8A33D"
                                        Text="确认 mod 存在此问题再开启！"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch
                                    Grid.Column="1"
                                    MinWidth="0"
                                    OffContent=""
                                    OnContent=""
                                    IsEnabled="{x:Bind ViewModel.CanEditFixOptions, Mode=OneWay}"
                                    IsOn="{x:Bind ViewModel.FixAeroEnabled, Mode=TwoWay}" />
                            </Grid>
                            <controls:Segmented
                                HorizontalAlignment="Stretch"
                                IsEnabled="{x:Bind ViewModel.CanEditFixOptions, Mode=OneWay}"
                                SelectedIndex="{x:Bind ViewModel.FixAeroModeIndex, Mode=TwoWay}"
                                SelectionMode="Single"
                                Visibility="{x:Bind ViewModel.FixAeroEnabled, Mode=OneWay}">
                                <controls:SegmentedItem Content="TexCoord 覆盖" l:Uids.Uid="Overlay_FixAeroMode1" />
                                <controls:SegmentedItem Content="贴图镜像反转" l:Uids.Uid="Overlay_FixAeroMode2" />
                            </controls:Segmented>
                            <TextBlock
                                FontSize="10"
                                Foreground="#99FFFFFF"
                                Text="一种方式修完仍有问题，请先回滚再换另一种。"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind ViewModel.FixAeroEnabled, Mode=OneWay}" />
                        </StackPanel>

                        <!--  UHD 贴图修复：档位 + 配置侧修复。哈希侧复用上面的“补全贴图状态”，
                              配置侧按 Rocket 的 XXMI 方式改 Engine.ini / GameUserSettings.ini（先备份）。  -->
                        <Border
                            Padding="8"
                            Background="#14FFFFFF"
                            CornerRadius="6">
                            <StackPanel Spacing="6">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Text="UHD 贴图修复" />
                                <TextBlock
                                    FontSize="10"
                                    Foreground="#99FFFFFF"
                                    Text="一键完成 HD/UHD 两次观察并生成映射；不需要 Rocket，也不需要手动改 ini。档位只对「内置注入启动」生效；用「Start Wuthering Waves (XXMI)」启动时以 XXMI 自己的设置为准。"
                                    TextWrapping="Wrap" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox
                                        HorizontalAlignment="Stretch"
                                        Header="资源档位"
                                        ItemsSource="{x:Bind ViewModel.UhdTierOptions}"
                                        SelectedIndex="{x:Bind ViewModel.UhdTierIndex, Mode=TwoWay}" />
                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Bottom"
                                        Orientation="Horizontal"
                                        Spacing="6">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Text="内置注入" />
                                        <ToggleSwitch
                                            MinWidth="0"
                                            OffContent=""
                                            OnContent=""
                                            IsOn="{x:Bind ViewModel.UseInjectionLaunch, Mode=TwoWay}" />
                                    </StackPanel>
                                </Grid>
                                <Button
                                    HorizontalAlignment="Stretch"
                                    Command="{x:Bind ViewModel.LaunchWithTierCommand}"
                                    Content="按所选档位启动游戏（内置注入）"
                                    FontSize="11"
                                    IsEnabled="{x:Bind ViewModel.CanRunUhdActions, Mode=OneWay}" />
                                <Button
                                    Height="34"
                                    HorizontalAlignment="Stretch"
                                    Command="{x:Bind ViewModel.StartSelfLearningCommand}"
                                    Content="一键学习并修复（HD + UHD）"
                                    FontSize="12"
                                    IsEnabled="{x:Bind ViewModel.CanStartSelfLearning, Mode=OneWay}" />
                                <TextBlock
                                    FontSize="10"
                                    Foreground="#99FFFFFF"
                                    Text="先在 Mod 列表里只启用要学习的那一个（其余停用），再点这个按钮。向导会启动两次游戏（HD → UHD）：每次让角色（穿着该 Mod）出现在画面里，然后退出游戏，向导会自动继续。"
                                    TextWrapping="Wrap" />
                                <Button
                                    HorizontalAlignment="Stretch"
                                    Command="{x:Bind ViewModel.ScanUhdCoverageCommand}"
                                    Content="体检全部 Mod（生成 UHD 覆盖报告）"
                                    FontSize="11"
                                    IsEnabled="{x:Bind ViewModel.CanRunUhdActions, Mode=OneWay}" />
                                <TextBlock
                                    FontSize="10"
                                    Foreground="#99FFFFFF"
                                    Text="体检不启动游戏：按角色统计哪些 Mod 的贴图 hash 还没被 UHD 映射覆盖，报告写到 UhdRuntime\coverage-report.txt。"
                                    TextWrapping="Wrap" />
                                <Border
                                    Padding="8"
                                    Background="#0FFFFFFF"
                                    CornerRadius="6"
                                    Visibility="{x:Bind ViewModel.IsSelfLearning, Mode=OneWay}">
                                    <StackPanel Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <ProgressRing
                                                Width="16"
                                                Height="16"
                                                IsActive="{x:Bind ViewModel.IsSelfLearning, Mode=OneWay}" />
                                            <TextBlock
                                                FontSize="10"
                                                Foreground="#E6FFFFFF"
                                                Text="{x:Bind ViewModel.SelfLearnStatus, Mode=OneWay}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button
                                            HorizontalAlignment="Stretch"
                                            Command="{x:Bind ViewModel.CancelSelfLearningCommand}"
                                            Content="取消学习"
                                            FontSize="11" />
                                    </StackPanel>
                                </Border>
                                <Expander
                                    HorizontalAlignment="Stretch"
                                    Header="更多修复工具"
                                    IsExpanded="False">
                                    <StackPanel Padding="0,8,0,0" Spacing="6">
                                        <ComboBox
                                            HorizontalAlignment="Stretch"
                                            Header="修复方式（旧流程）"
                                            ItemsSource="{x:Bind ViewModel.UhdFixModeOptions}"
                                            SelectedIndex="{x:Bind ViewModel.UhdFixModeIndex, Mode=TwoWay}" />
                                        <TextBlock
                                            FontSize="10"
                                            Foreground="#99FFFFFF"
                                            Text="旧流程：普通 mod 用「基础哈希修复」；依赖 RabbitFX 的状态贴图用第三项。"
                                            TextWrapping="Wrap" />
                                        <Button
                                            HorizontalAlignment="Stretch"
                                            Command="{x:Bind ViewModel.ImportUhdAliasesCommand}"
                                            Content="导入 Rocket UHD 映射（需先学习）"
                                            FontSize="11"
                                            IsEnabled="{x:Bind ViewModel.CanRunUhdActions, Mode=OneWay}" />
                                        <Button
                                            HorizontalAlignment="Stretch"
                                            Command="{x:Bind ViewModel.ImportRocketBuiltinCommand}"
                                            Content="导入 Rocket 内置映射（选 Lod0_texture.dll）"
                                            FontSize="11"
                                            IsEnabled="{x:Bind ViewModel.CanRunUhdActions, Mode=OneWay}" />

                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        HorizontalAlignment="Stretch"
                                        Command="{x:Bind ViewModel.RunUhdHashFixCommand}"
                                        Content="执行 UHD 修复"
                                        FontSize="11"
                                        IsEnabled="{x:Bind ViewModel.CanRunUhdActions, Mode=OneWay}" />
                                    <Button
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        Command="{x:Bind ViewModel.ApplyUhdConfigCommand}"
                                        Content="应用配置修复"
                                        FontSize="11"
                                        IsEnabled="{x:Bind ViewModel.CanRunUhdActions, Mode=OneWay}" />
                                </Grid>
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        HorizontalAlignment="Stretch"
                                        Command="{x:Bind ViewModel.RestoreUhdConfigCommand}"
                                        Content="恢复配置备份"
                                        FontSize="11"
                                        IsEnabled="{x:Bind ViewModel.CanRunUhdActions, Mode=OneWay}" />
                                    <Button
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        Command="{x:Bind ViewModel.RefreshUhdStatusCommand}"
                                        Content="刷新状态"
                                        FontSize="11"
                                        IsEnabled="{x:Bind ViewModel.CanRunUhdActions, Mode=OneWay}" />
                                        </Grid>
                                    </StackPanel>
                                </Expander>
                                <TextBlock
                                    FontSize="10"
                                    Foreground="#CCFFFFFF"
                                    Text="{x:Bind ViewModel.UhdStatusMessage, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind ViewModel.HasUhdStatus, Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <Button
                            HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.StartFixCommand}"
                            Content="开始修复"
                            FontSize="12"
                            IsEnabled="{x:Bind ViewModel.CanStartFix, Mode=OneWay}" />

                        <Button
                            HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.TerminateFixCommand}"
                            Content="终止"
                            FontSize="11"
                            Visibility="{x:Bind ViewModel.FixSession.IsRunning, Mode=OneWay}" />

                        <StackPanel
                            Spacing="2"
                            Visibility="{x:Bind ViewModel.FixSession.IsRunning, Mode=OneWay}">
                            <ProgressBar Maximum="100" Value="{x:Bind ViewModel.FixSession.Percent, Mode=OneWay}" />
                            <TextBlock
                                FontSize="11"
                                Foreground="#E6FFFFFF"
                                Text="{x:Bind ViewModel.FixSession.CurrentModName, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock FontSize="10" Foreground="#99FFFFFF" Text="成功" />
                                <TextBlock FontSize="10" Text="{x:Bind ViewModel.FixSession.SuccessCount, Mode=OneWay}" />
                                <TextBlock FontSize="10" Foreground="#99FFFFFF" Text="跳过" />
                                <TextBlock FontSize="10" Text="{x:Bind ViewModel.FixSession.SkippedCount, Mode=OneWay}" />
                                <TextBlock FontSize="10" Foreground="#99FFFFFF" Text="失败" />
                                <TextBlock FontSize="10" Text="{x:Bind ViewModel.FixSession.FailedCount, Mode=OneWay}" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock
                            FontSize="11"
                            Foreground="#E6FFFFFF"
                            Text="{x:Bind ViewModel.FixMessage, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.HasFixMessage, Mode=OneWay}" />

                        <ToggleSwitch
                            MinWidth="0"
                            FontSize="11"
                            Header="日志"
                            OffContent=""
                            OnContent=""
                            IsOn="{x:Bind ViewModel.IsLogExpanded, Mode=TwoWay}" />
                        <ScrollViewer
                            MaxHeight="150"
                            Visibility="{x:Bind ViewModel.IsLogExpanded, Mode=OneWay}">
                            <TextBlock
                                FontFamily="Consolas"
                                FontSize="10"
                                Foreground="#CCFFFFFF"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind ViewModel.FixSession.LogText, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </ScrollViewer>

                        <!--  修复完成后的 F10 结果仍要能看到；Mod 页的状态区在修复页是隐藏的。  -->
                        <TextBlock
                            FontSize="11"
                            Foreground="#E6FFFFFF"
                            Text="{x:Bind ViewModel.RefreshCoordinator.StatusMessage, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.HasRefreshStatus, Mode=OneWay}" />

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="#99FFFFFF"
                                Text="{x:Bind ViewModel.ConfigVersionText, Mode=OneWay}" />
                            <Button
                                Grid.Column="1"
                                Command="{x:Bind ViewModel.UpdateConfigCommand}"
                                Content="更新配置"
                                FontSize="11"
                                IsEnabled="{x:Bind ViewModel.CanEditFixOptions, Mode=OneWay}" />
                            <Ellipse
                                Grid.Column="2"
                                Width="6"
                                Height="6"
                                Margin="2,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Fill="#FFE8A33D"
                                Visibility="{x:Bind ViewModel.HasConfigUpdate, Mode=OneWay}" />
                        </Grid>
                    </StackPanel>

                    <!--  ── 回滚视图 ──  -->
                    <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.IsRollbackViewActive, Mode=OneWay}">
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="6"
                            Visibility="{x:Bind ViewModel.IsRollbackScanning, Mode=OneWay}">
                            <ProgressRing Width="14" Height="14" IsActive="True" />
                            <TextBlock FontSize="11" Text="正在扫描备份…" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock
                            FontSize="11"
                            Foreground="#B3FFFFFF"
                            Text="无历史备份 (.BAK)"
                            Visibility="{x:Bind ViewModel.HasNoRestorePoints, Mode=OneWay}" />

                        <ListView
                            MaxHeight="280"
                            ItemsSource="{x:Bind ViewModel.RestorePoints}"
                            SelectedItem="{x:Bind ViewModel.SelectedRestorePoint, Mode=TwoWay}"
                            SelectionMode="Single"
                            Visibility="{x:Bind ViewModel.HasRestorePoints, Mode=OneWay}">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="Padding" Value="4,3" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="overlayVm:OverlayRestorePointItem">
                                    <StackPanel Spacing="1">
                                        <TextBlock FontSize="12" Text="{x:Bind DisplayTime}" />
                                        <TextBlock FontSize="10" Foreground="#99FFFFFF" Text="{x:Bind SummaryText}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Button
                            HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.RollbackSelectedCommand}"
                            Content="回滚到此还原点"
                            FontSize="11"
                            IsEnabled="{x:Bind ViewModel.CanRollbackSelected, Mode=OneWay}" />

                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.RestoreEarliestCommand}"
                                Content="还原到最早"
                                FontSize="11"
                                IsEnabled="{x:Bind ViewModel.CanRollback, Mode=OneWay}" />
                            <Button
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.CleanBackupsCommand}"
                                Content="{x:Bind ViewModel.CleanBackupsLabel, Mode=OneWay}"
                                FontSize="11"
                                IsEnabled="{x:Bind ViewModel.CanRollback, Mode=OneWay}" />
                        </Grid>

                        <Button
                            HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.RefreshRestorePointsCommand}"
                            Content="刷新还原点"
                            FontSize="11" />

                        <TextBlock
                            FontSize="11"
                            Foreground="#E6FFFFFF"
                            Text="{x:Bind ViewModel.RollbackMessage, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.HasRollbackMessage, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!--  删除确认：盖住整个浮窗（含标题条），背景吃掉指针。必须留在浮窗内部 ——
                  主窗口 ContentDialog 会激活主窗口、把游戏踢出前台。  -->
            <Grid
                Grid.RowSpan="7"
                Background="#A6000000"
                Visibility="{x:Bind ViewModel.IsDeleteConfirmVisible, Mode=OneWay}">
                <Border
                    MaxWidth="360"
                    Margin="20"
                    Padding="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#FF1B1C22"
                    BorderBrush="#40FFFFFF"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="10">
                        <TextBlock
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="删除这个 Mod？" />
                        <TextBlock
                            FontSize="12"
                            Foreground="#E6FFFFFF"
                            Text="{x:Bind ViewModel.DeleteConfirmModName, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            FontSize="11"
                            Foreground="#FFE8A33D"
                            Text="整个 Mod 文件夹会移至 Windows 回收站，可从回收站恢复。"
                            TextWrapping="Wrap" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.CancelDeleteCommand}"
                                Content="取消"
                                IsEnabled="{x:Bind ViewModel.CanConfirmDelete, Mode=OneWay}" />
                            <Button
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                Background="#FFC62828"
                                BorderThickness="0"
                                Command="{x:Bind ViewModel.ConfirmDeleteCommand}"
                                Content="{x:Bind ViewModel.ConfirmDeleteButtonText, Mode=OneWay}"
                                Foreground="White"
                                IsEnabled="{x:Bind ViewModel.CanConfirmDelete, Mode=OneWay}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Page>
</winUiEx:WindowEx>
