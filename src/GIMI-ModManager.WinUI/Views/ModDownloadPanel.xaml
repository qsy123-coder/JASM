<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="GIMI_ModManager.WinUI.Views.ModDownloadPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:CommunityToolkit.WinUI.UI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:l="using:WinUI3Localizer"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:GIMI_ModManager.WinUI.ViewModels"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter
            x:Key="BoolToVisibilityConverter"
            TrueValue="Visible"
            FalseValue="Collapsed" />
        <!-- 空状态要用「列表是空的时候显示」，所以再来一份反过来的 -->
        <converters:BoolToVisibilityConverter
            x:Key="InverseBoolToVisibilityConverter"
            TrueValue="Collapsed"
            FalseValue="Visible" />

        <!-- 滑入/滑出与商店详情抽屉同一套参数(抽屉宽度也都是 460，改宽度要连动画一起改) -->
        <Storyboard x:Name="SlideInStoryboard">
            <DoubleAnimation Storyboard.TargetName="DrawerBorder"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             From="460" To="0" Duration="0:0:0.30">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="PanelRoot"
                             Storyboard.TargetProperty="Opacity"
                             From="0.01" To="1" Duration="0:0:0.25" />
        </Storyboard>

        <Storyboard x:Name="SlideOutStoryboard">
            <DoubleAnimation Storyboard.TargetName="DrawerBorder"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             From="0" To="460" Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="PanelRoot"
                             Storyboard.TargetProperty="Opacity"
                             From="1" To="0.01" Duration="0:0:0.20" />
        </Storyboard>

        <!-- 一个下载任务。多数字段会随下载进度变，所以全是 OneWay(OneTime 会让进度条冻住)。 -->
        <DataTemplate x:Key="DownloadRowTemplate" x:DataType="viewModels:ModDownloadItemViewModel">
            <Grid Padding="10,8" RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- mod 名 + 状态 -->
                <Grid Grid.Row="0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{x:Bind DisplayName, Mode=OneWay}"
                               FontSize="13" FontWeight="SemiBold" MaxLines="1"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{x:Bind StatusText, Mode=OneWay}"
                               FontSize="11" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>

                <TextBlock Grid.Row="1" Text="{x:Bind SubtitleText, Mode=OneWay}"
                           FontSize="11" TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                <ProgressBar Grid.Row="2" Height="3" Minimum="0" Maximum="100"
                             Value="{x:Bind ProgressValue, Mode=OneWay}"
                             IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}"
                             Visibility="{x:Bind ShowProgress, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />

                <!-- 字节数 / 速度 + 操作按钮 -->
                <Grid Grid.Row="3" ColumnSpacing="8" Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{x:Bind ProgressText, Mode=OneWay}"
                               FontSize="11" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <Button Padding="8,2" CornerRadius="4" FontSize="11"
                                l:Uids.Uid="ModStore_Download_Pause" Content="暂停"
                                Command="{x:Bind PauseCommand}"
                                Visibility="{x:Bind CanPause, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                        <Button Padding="8,2" CornerRadius="4" FontSize="11"
                                l:Uids.Uid="ModStore_Download_Resume" Content="继续"
                                Command="{x:Bind ResumeCommand}"
                                Visibility="{x:Bind CanResume, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                        <Button Padding="8,2" CornerRadius="4" FontSize="11"
                                l:Uids.Uid="ModStore_Download_Cancel" Content="取消"
                                Command="{x:Bind CancelCommand}"
                                Visibility="{x:Bind CanCancel, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                    </StackPanel>
                </Grid>

                <!-- 失败原因 / 下好了但后续没做成(入库、拉起安装向导) -->
                <TextBlock Grid.Row="4" Text="{x:Bind ErrorText, Mode=OneWay}"
                           FontSize="11" TextWrapping="Wrap" Foreground="#FF6B6B"
                           Visibility="{x:Bind HasError, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="PanelRoot" Visibility="Collapsed" Opacity="0.01">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="460" />
        </Grid.ColumnDefinitions>

        <!-- 点空白处关闭 -->
        <Grid Grid.Column="0" Background="#01000000" IsTapEnabled="True" Tapped="TapCloseArea_Tapped" />

        <Border x:Name="DrawerBorder" Grid.Column="1"
                VerticalAlignment="Stretch"
                BorderBrush="#30000000" BorderThickness="1,0,0,0"
                Background="{ThemeResource SystemControlAcrylicWindowBrush}">
            <Border.RenderTransform>
                <TranslateTransform X="460" />
            </Border.RenderTransform>

            <Grid Padding="20,0,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 标题 + 任务概况 + 关闭 -->
                <Grid Grid.Row="0" Margin="0,20,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock FontSize="16" FontWeight="Bold"
                                   l:Uids.Uid="ModStore_Download_Title" Text="下载管理" />
                        <TextBlock Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1" Width="32" Height="32" Padding="0"
                            VerticalAlignment="Top"
                            Background="Transparent" BorderThickness="0"
                            CornerRadius="16" Click="CloseButton_Click">
                        <FontIcon FontSize="12" Glyph="&#xE711;" />
                    </Button>
                </Grid>

                <!-- 批量操作:只对未完成的「全部取消」、只对已完成/失败的「清除」 -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
                    <Button Padding="10,3" CornerRadius="6" FontSize="12"
                            l:Uids.Uid="ModStore_Download_CancelAll" Content="全部取消"
                            IsEnabled="{x:Bind ViewModel.HasUnfinished, Mode=OneWay}"
                            Command="{x:Bind ViewModel.CancelAllCommand}" />
                    <Button Padding="10,3" CornerRadius="6" FontSize="12"
                            l:Uids.Uid="ModStore_Download_ClearFinished" Content="清除已完成"
                            IsEnabled="{x:Bind ViewModel.HasFinished, Mode=OneWay}"
                            Command="{x:Bind ViewModel.ClearFinishedCommand}" />
                </StackPanel>

                <!-- 任务列表(ListView 自带滚动,所以外层不再套 ScrollViewer) -->
                <ListView Grid.Row="2" SelectionMode="None"
                          ItemsSource="{x:Bind ViewModel.Items}"
                          ItemTemplate="{StaticResource DownloadRowTemplate}"
                          Visibility="{x:Bind ViewModel.HasItems, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,4" />
                            <Setter Property="CornerRadius" Value="6" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>

                <TextBlock Grid.Row="2" VerticalAlignment="Top"
                           Text="{x:Bind ViewModel.EmptyText}" FontSize="12" TextWrapping="Wrap"
                           LineHeight="19"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Visibility="{x:Bind ViewModel.HasItems, Converter={StaticResource InverseBoolToVisibilityConverter}, Mode=OneWay}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
