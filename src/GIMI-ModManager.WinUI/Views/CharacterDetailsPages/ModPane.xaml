<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="GIMI_ModManager.WinUI.Views.CharacterDetailsPages.ModPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GIMI_ModManager.WinUI.Views.Controls"
    xmlns:controls1="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:l="using:WinUI3Localizer"
    xmlns:local="using:GIMI_ModManager.WinUI.Views.CharacterDetailsPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:subViewModels="using:GIMI_ModManager.WinUI.ViewModels.CharacterDetailsViewModels.SubViewModels"
    xmlns:xaml="using:GIMI_ModManager.WinUI.Helpers.Xaml"
    xmlns:coreHelpers="using:GIMI_ModManager.Core.Entities.Mods.Helpers"
    IsEnabled="{x:Bind ViewModel.IsNotReadOnly, Mode=OneWay}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <xaml:StringToUri x:Name="StringToUri" />
        <xaml:KeyToArrowGlyphConverter x:Key="KeyToArrowGlyphConverter" />
        <xaml:ArrowKeyToVisibilityConverter x:Key="ArrowKeyToVisibilityConverter" />
        <xaml:ArrowKeyToIconVisibilityConverter x:Key="ArrowKeyToIconVisibilityConverter" />
    </UserControl.Resources>

    <Grid
        x:Name="ModDetailsPane"
        Grid.Column="1"
        Margin="0,0,0,8"
        Padding="5,5,5,5"
        Background="{ThemeResource ControlFillColorDefaultBrush}"
        CornerRadius="10">


        <Grid.RowDefinitions>
            <RowDefinition Height="5.5*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="4.5*" />
            <RowDefinition Height="Auto" />

        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0"
            MinWidth="200"
            MinHeight="200"
            AllowDrop="True"
            Background="{ThemeResource ControlFillColorTertiaryBrush}"
            CornerRadius="10"
            DragEnter="PaneImage_OnDragEnter"
            DragOver="PaneImage_OnDragEnter"
            Drop="PaneImage_OnDrop">
            <!--
            -->
            <!--<Image Stretch="Uniform">
                <Image.Source>
                    <BitmapImage CreateOptions="IgnoreImageCache" UriSource="{x:Bind ViewModel.ModModel.ImageUri, Mode=OneWay}" />
                </Image.Source>
            </Image>
            <Button
                Margin="0,20,20,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                IsEnabled="{x:Bind ViewModel.IsNotReadOnly, Mode=OneWay}">
            -->
            <!--
                Command="{x:Bind ViewModel.ModPaneVM.SetImageUriCommand}"
            -->
            <!--
                <FontIcon Glyph="&#xE70F;" />
            </Button>-->

            <!-- 背景模糊放大效果 -->
            <Image Stretch="UniformToFill" Opacity="0.15">
                <Image.Source>
                    <BitmapImage CreateOptions="IgnoreImageCache"
                                 UriSource="{x:Bind ViewModel.ModModel.ImageUri, Mode=OneWay}" />
                </Image.Source>
            </Image>
            <controls:CustomImage
                x:Name="ModDetailsPaneImage"
                ButtonHorizontalAlignment="Right"
                ButtonVerticalAlignment="Top"
                ClearButtonCommand="{x:Bind ViewModel.ClearImageCommand}"
                CopyButtonCommand="{x:Bind ViewModel.CopyImageToClipboardCommand}"
                EditButtonCommand="{x:Bind ViewModel.PickImageUriCommand}"
                ImageUri="{x:Bind ViewModel.ModModel.ImageUri, Mode=OneWay}"
                IsContextMenuEnabled="True"
                PasteButtonCommand="{x:Bind ViewModel.PasteImageFromClipboardCommand}" />
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <controls:EditableTextBlock
                x:Name="ModNameTextBlock"
                Margin="0,8"
                HorizontalAlignment="Stretch"
                IsEditMode="{x:Bind ViewModel.IsEditingModName, Mode=OneWay}"
                Style="{ThemeResource SubtitleTextBlockStyle}"
                TextAlignment="Center"
                ToolTipService.ToolTip="Change mod display name"
                Text="{x:Bind ViewModel.ModModel.ModDisplayName, Mode=TwoWay}"
                l:Uids.Uid="ModPane_ModNameTextBlock" />



            <SplitButton
                Grid.Column="1"
                Command="{x:Bind ViewModel.ToggleEditingModNameCommand}"
                IsEnabled="{x:Bind ViewModel.IsNotReadOnly, Mode=OneWay}">
                <FontIcon Glyph="&#xE70F;" />
                <SplitButton.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <MenuFlyoutItem
                            Command="{x:Bind ViewModel.SetModIniFileCommand}"
                            ToolTipService.ToolTip="Set the mod .ini file to be read by JASM"
                            Text="Set mod .ini file"
                            l:Uids.Uid="ModPane_SetModIniFile" />
                        <MenuFlyoutItem
                            Command="{x:Bind ViewModel.ClearSetModIniFileCommand}"
                            Icon="Clear"
                            ToolTipService.ToolTip="JASM will not look for merged.ini/Script.ini file and ignore keyswaps for this mod"
                            Text="Ignore .ini file for this mod"
                            l:Uids.Uid="ModPane_IgnoreModIniFile" />
                    </MenuFlyout>
                </SplitButton.Flyout>

            </SplitButton>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                VerticalAlignment="Center"
                Header="Mod Url:"
                IsEnabled="{x:Bind ViewModel.IsNotReadOnly, Mode=OneWay}"
                Text="{x:Bind ViewModel.ModModel.ModUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                l:Uids.Uid="ModPane_ModUrlBox" />

            <HyperlinkButton
                Grid.Column="1"
                VerticalAlignment="Bottom"
                IsEnabled="{x:Bind ViewModel.IsNotReadOnly, Mode=OneWay}"
                NavigateUri="{x:Bind ViewModel.ModModel.ModUrl, Mode=OneWay, Converter={StaticResource StringToUri}}">
                <FontIcon FontSize="18" Glyph="&#xE8A7;" />
            </HyperlinkButton>

        </Grid>


        <!-- Key Swaps (Row 3) - 可折叠，默认收起 -->
        <StackPanel Grid.Row="3" Margin="0,6,0,0" Spacing="6"
                    Visibility="{x:Bind ViewModel.IsModLoaded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <!-- 折叠标题行 -->
            <Button Background="Transparent" BorderThickness="0" Padding="0"
                    HorizontalAlignment="Left"
                    Click="KeySwapToggle_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="14" Glyph="&#xE785;"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              VerticalAlignment="Center" />
                    <TextBlock FontSize="20" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Text="前进 / 后退按键" />
                    <FontIcon x:Name="KeySwapChevron" FontSize="10"
                              Glyph="&#xE70D;"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <!-- 可折叠内容（默认收起）+ 滚动 -->
            <StackPanel x:Name="KeySwapContent" Visibility="Collapsed">
                <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                    <controls1:SwitchPresenter Value="{x:Bind ViewModel.ModModel.IsKeySwapManagementEnabled, Mode=OneWay}">
                        <controls1:Case Value="true">
                            <StackPanel>
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.ModModel.KeySwaps, Mode=OneWay}">
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="subViewModels:ModPaneFieldsKeySwapVm">
                                            <Grid Margin="0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox
                                                    MinWidth="100"
                                                    HorizontalAlignment="Left"
                                                    Header="Forward Key"
                                                    Text="{x:Bind ForwardHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    l:Uids.Uid="ModPane_ForwardKeyBox" />

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock HorizontalAlignment="Center" Text="{x:Bind SectionKey}" />
                                                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                                        <TextBlock Margin="0,0,4,0" Text="Variations: " l:Uids.Uid="ModPane_VariationsLabel" />
                                                        <TextBlock Text="{x:Bind VariationsCount, Mode=OneWay}" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <TextBox
                                                    Grid.Column="2"
                                                    MinWidth="100"
                                                    HorizontalAlignment="Right"
                                                    Header="Backward Key"
                                                    Text="{x:Bind BackwardHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    l:Uids.Uid="ModPane_BackwardKeyBox" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </controls1:Case>

                        <controls1:Case Value="false">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                TextWrapping="WrapWholeWords"
                                Text="Key swap management is disabled for this mod"
                                l:Uids.Uid="ModPane_KeySwapDisabled" />
                        </controls1:Case>
                    </controls1:SwitchPresenter>
                </ScrollViewer>
            </StackPanel>
        </StackPanel>

        <!-- Key Binding Hints (Row 4) - 标题固定，按ini文件夹折叠，内容填满下方 -->
        <Grid Grid.Row="4" Margin="0,6,0,0"
              Visibility="{x:Bind ViewModel.ModModel.HasKeyBindings, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!-- 标题行（固定不动） -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6">
                <FontIcon FontSize="14" Glyph="&#xEDA4;"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="0">
                    <TextBlock FontSize="20" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Text="{x:Bind ViewModel.ModModel.ModDisplayName, Mode=OneWay}" />
                    <TextBlock FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Text=" 按键映射" />
                </StackPanel>
            </StackPanel>
            <!-- 内容：填满剩余空间 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden"
                          VerticalAlignment="Stretch">
                <StackPanel x:Name="KeyBindingHintPanel" Spacing="10">
                    <!-- 按 ini 文件分组，点击文件夹名折叠 -->
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.ModModel.KeyBindingGroups, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Vertical" Spacing="12" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="coreHelpers:ModIniKeyBindingGroup">
                                <StackPanel Spacing="4">
                                    <!-- ini 文件路径（可点击折叠）+ 打开文件 -->
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Button Background="Transparent" BorderThickness="0"
                                                Padding="0" HorizontalAlignment="Left"
                                                Click="{x:Bind ToggleExpanded}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock FontSize="18" FontWeight="Bold"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           VerticalAlignment="Center"
                                                           Text="{x:Bind ShortPath}" />
                                                <FontIcon FontSize="10"
                                                          Glyph="{x:Bind IsExpandedGlyph, Mode=OneWay}"
                                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                          VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Background="Transparent" BorderThickness="0"
                                                Padding="0" Width="20" Height="20"
                                                VerticalAlignment="Center"
                                                ToolTipService.ToolTip="打开 ini 文件"
                                                Click="{x:Bind OpenIniFile}">
                                            <FontIcon FontSize="12" Glyph="&#xE8A7;"
                                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </Button>
                                    </StackPanel>
                                    <!-- 按键绑定条目（可折叠） -->
                                    <ItemsRepeater ItemsSource="{x:Bind Bindings}"
                                                   Visibility="{x:Bind IsExpanded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Orientation="Vertical" Spacing="6" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="coreHelpers:ModIniKeyBindingEntry">
                                                <StackPanel Spacing="2">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" FontSize="13"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                                   Text="{x:Bind DisplayLabel}" />
                                                        <!-- 箭头按键 → 圆角徽章 -->
                                                        <Border Grid.Column="1" Padding="6,2" CornerRadius="4"
                                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                BorderThickness="0.5"
                                                                Visibility="{x:Bind IsArrowKey, Converter={StaticResource ArrowKeyToIconVisibilityConverter}}">
                                                            <TextBlock FontSize="16"
                                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                                       VerticalAlignment="Center"
                                                                       Text="{x:Bind KeyValue}" />
                                                        </Border>
                                                        <!-- 普通按键 → 圆角徽章 -->
                                                        <Border Grid.Column="1" Padding="8,3" CornerRadius="4"
                                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                BorderThickness="0.5"
                                                                Visibility="{x:Bind IsArrowKey, Converter={StaticResource ArrowKeyToVisibilityConverter}}">
                                                            <TextBlock FontSize="13" FontFamily="Consolas"
                                                                       FontWeight="SemiBold"
                                                                       Text="{x:Bind KeyValue}" />
                                                        </Border>
                                                    </Grid>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 无按键绑定时显示 -->
        <StackPanel Grid.Row="4" Margin="0,8,0,0" Orientation="Horizontal" Spacing="6"
                    Visibility="{x:Bind ViewModel.ModModel.HasNoKeyBindings, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <FontIcon FontSize="14" Glyph="&#xEDA4;"
                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                      VerticalAlignment="Center" />
            <TextBlock Text="此模组无按键绑定" FontSize="12"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       VerticalAlignment="Center" />
        </StackPanel>


        <Grid Grid.Row="5" Padding="0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                Background="{ThemeResource SystemFillColorAttentionBrush}"
                Command="{x:Bind ViewModel.SaveModSettingsCommand}"
                IsEnabled="{x:Bind ViewModel.IsNotReadOnly, Mode=OneWay}">
                <Button.Content>
                    <StackPanel Orientation="Horizontal">
                        <FontIcon Margin="0,0,4,0" Glyph="&#xE74E;" />
                        <TextBlock Text="Save" l:Uids.Uid="ModPane_SaveLabel" />
                    </StackPanel>
                </Button.Content>
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="S" Modifiers="Control" />
                </Button.KeyboardAccelerators>

            </Button>

            <Grid Grid.Column="1" Visibility="{x:Bind ViewModel.ModModel.IsEnabled, Mode=OneWay}">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="1"
                    Background="{ThemeResource AccentFillColorSelectedTextBackgroundBrush}"
                    CornerRadius="10">
                    <TextBlock
                        Padding="4,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Text="Mod Enabled"
                        l:Uids.Uid="ModPane_ModEnabledLabel" />
                </Border>

            </Grid>


            <Button
                Grid.Column="2"
                HorizontalAlignment="Right"
                Command="{x:Bind ViewModel.OpenModFolderCommand}"
                Content="Open Mod Folder..."
                IsEnabled="{x:Bind ViewModel.IsNotReadOnly, Mode=OneWay}"
                l:Uids.Uid="ModPane_OpenModFolderButton" />
        </Grid>
    </Grid>
</UserControl>
