<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GIMI_ModManager.WinUI.Views.ModStorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:CommunityToolkit.WinUI.UI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:l="using:WinUI3Localizer"
    xmlns:local="using:GIMI_ModManager.WinUI.Views.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:GIMI_ModManager.WinUI.Models"
    xmlns:views="using:GIMI_ModManager.WinUI.Views"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter
            x:Key="BoolToVisibilityConverter"
            TrueValue="Visible"
            FalseValue="Collapsed" />

        <!-- 反向的那份:有真图标时要把底下的字形藏起来 -->
        <converters:BoolToVisibilityConverter
            x:Key="InverseBoolToVisibilityConverter"
            TrueValue="Collapsed"
            FalseValue="Visible" />

        <!-- 左侧栏一项:图标 + 名字 + 条目数。条目数在后台一个个补,所以是 OneWay 而不是 OneTime,
             还没取到(Null)时那一格是空的 —— 不显示数字,也不显示假的 0。
             图标同理但更晚:根分类的图随板块主页一次回来,角色的图要等那次搜索(见 ViewModel),
             所以两种状态都要能切换 —— 没有图时退回字形,不是留一格空白。 -->
        <DataTemplate x:Key="SidebarItemTemplate" x:DataType="models:ModStoreSidebarItem">
            <Grid Padding="12,10" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="20" Height="20" VerticalAlignment="Center">
                    <FontIcon FontSize="15" Glyph="{x:Bind Glyph}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              Visibility="{x:Bind HasIcon, Converter={StaticResource InverseBoolToVisibilityConverter}, Mode=OneWay}" />
                    <!-- DecodePixelWidth 按 2 倍显示尺寸解码(高分屏不糊),图标很小,不值得再走懒加载队列 -->
                    <Image Width="20" Height="20" Stretch="UniformToFill"
                           Visibility="{x:Bind HasIcon, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                        <Image.Source>
                            <BitmapImage DecodePixelWidth="40" UriSource="{x:Bind IconUrl, Mode=OneWay}" />
                        </Image.Source>
                    </Image>
                </Grid>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="13"
                           Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="{x:Bind ItemCount, Mode=OneWay}" />
            </Grid>
        </DataTemplate>

        <!-- 卡片版式:横屏 —— 图片在上、白色信息块在下,一行 6 个(列数由 WrapGridPanel.Columns 定,宽度均分)。
             信息块按 GameBanana 自家页面的卡片排:标题两行 + 作者行(头像 + 名字 + 右侧相对时间) + 统计三项。
             商店比那段版式多一层信息:图片左上角那块角色标签。

             ⚠️ 这里面所有数字都是**照参考图逐像素量出来的设计值**(参考图 = GameBanana 卡片网格截图,
             卡片外框 304×360、列距 330、行距 411、封面高 195、信息块高 161,单位就是截图里的 px)。
             卡片宽度是容器均分出来的、会随窗口变,所以这些值不能直接用 —— 整张卡由 code-behind 的
             CardScaler 按 s = 槽位宽 / 330 等比缩放(字号、内边距、外边距、圆角、头像、图标一起走),
             这样任何窗口宽度下卡片比例都和参考图一致。改这里的尺寸不用动代码,缩放会自己跟上。
             卡片外边距写的是**间距的一半**(相邻两张各摊一半):横向 13+13=26、纵向 25+25=50。 -->
        <DataTemplate x:Key="ModStoreCardTemplate">
            <Border Margin="13,25,13,25" Background="White" CornerRadius="12"
                    BorderBrush="#E8EBED" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 行0: 图片区。195 是参考图的封面高度,由 CardScaler 随整卡等比缩放 -->
                    <Grid x:Name="ThumbHost" Grid.Row="0" Height="195">
                        <!-- 层0: 无图片时的纯色占位背景 -->
                        <Grid Background="#2A2A2A" />
                        <!-- 层1: 图片加载动画(滚动到视口才开始加载,离屏折叠,不空转) -->
                        <ProgressRing x:Name="CardLoadingRing" IsActive="False"
                                      Visibility="Collapsed"
                                      Width="28" Height="28"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Foreground="#0078D4" />
                        <!-- 层2: 图片铺满(Source 由代码在滚到视口时设置) -->
                        <Image x:Name="CardImage"
                               Stretch="UniformToFill"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               ImageOpened="CardImage_Opened" ImageFailed="CardImage_Failed" />
                        <!-- 层3: 角色标签(左上)。不是每条记录都有角色(UI 类 mod 就没有),没有就不显示。 -->
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                Margin="12" Padding="8,3" Background="#99000000"
                                CornerRadius="8"
                                Visibility="{Binding HasCharacter, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Foreground="White" FontSize="14" FontWeight="SemiBold"
                                       Text="{Binding Character}" TextTrimming="CharacterEllipsis" />
                        </Border>
                        <!-- 层4: 右上角标(竖着排:NSFW 在上、已安装在下面一格)。
                             NSFW 这类条目默认隐藏模式下根本不会进列表,只有内容筛选切到「显示 NSFW」后才看得到。
                             已安装来自本地安装记录(不是 GameBanana 的记录),装完不刷新列表也会亮 —— 见 ModStoreItem.IsInstalled。 -->
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="12" Spacing="4">
                            <Border HorizontalAlignment="Right" Padding="8,3" Background="#E93A45"
                                    CornerRadius="8"
                                    Visibility="{Binding IsAdult, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Foreground="White" FontSize="15"
                                           FontWeight="SemiBold" Text="NSFW" />
                            </Border>
                            <Border HorizontalAlignment="Right" Padding="8,3" Background="#FF107C10"
                                    CornerRadius="8"
                                    Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Foreground="White" FontSize="15" FontWeight="SemiBold"
                                           l:Uids.Uid="ModStore_Card_Installed" Text="已安装" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- 行1: 信息块 —— 五段**定高行**(标题 54 / 空档 18 / 作者行 25 / 空档 9 / 统计行 24),
                         加内边距 17+14 正好 161,与参考图逐段对齐:标题首行墨迹顶 25、头像顶 88、
                         统计图标墨迹顶 127、块底 161。标题给两行高度,一行标题的卡片也占同样高度 ——
                         参考图里所有卡片等高,同一行的下边缘才齐。

                         为什么用 Grid 定高行而不是 StackPanel 自己撑:实测 TextBlock 量出来的高度会比设计值
                         多出一层字体行距(FontSize 20 时约 +9),StackPanel 会照单全收把整块顶高,
                         套定高容器也压不住(DesiredSize 依旧按内容算);Grid 的定高行则完全不受子元素影响。
                         LineHeight 也写死,免得标题里的中文字回退到别的字体、把行高顶起来(参考图行距就是 27)。 -->
                    <Grid Grid.Row="1" Padding="17,17,17,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="54" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="25" />
                            <RowDefinition Height="9" />
                            <RowDefinition Height="24" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Foreground="#1B1B1B" FontWeight="SemiBold" FontSize="20"
                                   LineHeight="27" LineStackingStrategy="BlockLineHeight"
                                   MaxLines="2" Text="{Binding Title}"
                                   TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />

                        <Grid Grid.Row="2" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- 作者头像:底色圆打底,真头像盖在上面(取不到头像 / 图加载失败就露出底色圆,
                                 所以这里不需要任何可见性切换 —— 清掉笔刷即可,见 LazyLoadVisibleImages)。
                                 作者没设过头像时 GameBanana 给的是默认头像,不是空值。 -->
                            <Grid Width="25" Height="25" VerticalAlignment="Center">
                                <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                                <!-- 名字挂在 Ellipse 上(笔刷是 Brush 不是 FrameworkElement,x:Name 认不到它) -->
                                <Ellipse x:Name="AuthorAvatar">
                                    <Ellipse.Fill>
                                        <ImageBrush Stretch="UniformToFill" />
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Grid>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="17"
                                       Foreground="#606061" Text="{Binding AuthorName}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="16"
                                       Foreground="#8C8C8D" Text="{Binding RelativeTime}" />
                        </Grid>

                        <!-- 统计三项:点赞 / 浏览 / 评论(顺序与 GameBanana 自家卡片一致)。
                             依参考图:图标是蓝的、数字才是灰的;图标比数字大一圈,两者都居中放。 -->
                        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="18">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <!-- EB51 是空心心形(EB52 是实心的,和参考图不符) -->
                                <FontIcon FontSize="20" Foreground="#3264A7" Glyph="&#xEB51;"
                                          VerticalAlignment="Center" />
                                <TextBlock FontSize="16" Foreground="#808081" VerticalAlignment="Center"
                                           Text="{Binding LikesCount}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="20" Foreground="#3264A7" Glyph="&#xE890;"
                                          VerticalAlignment="Center" />
                                <TextBlock FontSize="16" Foreground="#808081" VerticalAlignment="Center"
                                           Text="{Binding ViewsCount}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="20" Foreground="#3264A7" Glyph="&#xE8F2;"
                                          VerticalAlignment="Center" />
                                <TextBlock FontSize="16" Foreground="#808081" VerticalAlignment="Center"
                                           Text="{Binding CommentsCount}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧栏:分类(全部 + 板块根分类 + 角色) -->
        <Grid Grid.Column="0"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,0,1,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Margin="16,16,16,8" FontSize="18" FontWeight="Bold"
                       l:Uids.Uid="ModStore_CategoriesTitle" Text="分类" />
            <ListView x:Name="SidebarListView" Grid.Row="1"
                      ItemTemplate="{StaticResource SidebarItemTemplate}"
                      ItemsSource="{x:Bind ViewModel.Filters}"
                      SelectedItem="{x:Bind ViewModel.SelectedFilter, Mode=TwoWay}"
                      SelectionMode="Single">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="4,0" />
                        <Setter Property="CornerRadius" Value="6" />
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
        </Grid>

        <!-- 右侧主区 -->
        <Grid Grid.Column="1" Background="#F5F7FA">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 工具栏:搜索 + 内容筛选 + 排序 + 下载管理(版式同 Mod 市场) -->
            <Grid Grid.Row="0" MinHeight="50" Padding="12,8" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchBox" Grid.Column="0"
                         VerticalAlignment="Center" PlaceholderText="搜索模组..."
                         l:Uids.Uid="ModStore_SearchPlaceholder"
                         Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         CornerRadius="6" Margin="0,0,8,0">
                    <TextBox.Resources>
                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="White" />
                        <SolidColorBrush x:Key="TextControlBackground" Color="White" />
                    </TextBox.Resources>
                </TextBox>

                <ComboBox Grid.Column="1" Width="120" VerticalAlignment="Center"
                          CornerRadius="6" Background="White" Margin="0,0,8,0"
                          l:Uids.Uid="ModStore_ContentFilter"
                          ItemsSource="{x:Bind ViewModel.ContentFilterOptions}"
                          SelectedItem="{x:Bind ViewModel.SelectedContentFilter, Mode=TwoWay}" />

                <!-- 排序只对板块内容流有效:搜索端点不吃排序参数,分类端点直接拒绝 _sSort,
                     所以按分类/角色筛、或搜索时就置灰 -->
                <ComboBox Grid.Column="2" Width="100" VerticalAlignment="Center"
                          CornerRadius="6" Background="White" Margin="0,0,8,0"
                          IsEnabled="{x:Bind ViewModel.CanSort, Mode=OneWay}"
                          ToolTipService.ToolTip="排序仅对「全部」浏览有效；按分类、角色或关键词查找时顺序由服务端决定"
                          ItemsSource="{x:Bind ViewModel.SortOptions}"
                          SelectedItem="{x:Bind ViewModel.SelectedSortOption, Mode=TwoWay}" />

                <Button Grid.Column="3" Width="36" Height="36" VerticalAlignment="Center"
                        ToolTipService.ToolTip="下载管理" l:Uids.Uid="ModStore_DownloadManager"
                        Background="Transparent" BorderThickness="0" CornerRadius="6"
                        Command="{x:Bind ViewModel.OpenDownloadManagerCommand}">
                    <FontIcon FontSize="16" Glyph="&#xE896;" />
                </Button>
            </Grid>

            <!-- 内容区 -->
            <Grid Grid.Row="1">
                <ScrollViewer x:Name="CardScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalContentAlignment="Top"
                              ViewChanged="ScrollViewer_ViewChanged">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!-- 固定 6 列(横屏卡片一行 6 个),宽度均分;窗口窄到每列不足 180 时自动降列。
                             180 这个下限比旧值(150)高:卡片版式现在是整卡等比缩放的,列再窄下去字号会跟着
                             缩到看不清 —— 宁可少一列,让卡片大一点。180 能保住 1280/1366 窗口仍是 6 列。 -->
                        <local:WrapGridPanel x:Name="ModCardsPanel" Grid.Row="0"
                                             VerticalAlignment="Top"
                                             Columns="6" MinItemWidth="180" />
                        <!-- 滚动加载更多:内容流末尾,Collapsed 时不占位 -->
                        <StackPanel Grid.Row="1" HorizontalAlignment="Center"
                                    Margin="0,8,0,16"
                                    Visibility="{x:Bind ViewModel.IsLoadingMore, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                            <ProgressBar IsIndeterminate="True" Width="200" Height="4" />
                            <TextBlock Text="正在加载更多..." HorizontalAlignment="Center"
                                       Margin="0,4" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- 首次加载/重载指示器 -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0"
                            Visibility="{x:Bind ViewModel.IsInitialLoading, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                    <ProgressBar IsIndeterminate="True" Width="200" Height="4" />
                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                               HorizontalAlignment="Center" Margin="0,4" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- 空状态(含失败原因 + 重试) -->
                <Grid Background="#F5F7FA"
                      Visibility="{x:Bind ViewModel.IsEmpty, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480">
                        <TextBlock HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                   FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{x:Bind ViewModel.EmptyStateMessage, Mode=OneWay}" />
                        <Button Content="重试" HorizontalAlignment="Center" Margin="0,12,0,0"
                                CornerRadius="6"
                                Command="{x:Bind ViewModel.RefreshCommand}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- 详情抽屉:盖住整页(含左侧栏),与市场侧同一个挂法 -->
        <views:ModStoreDetailPanel x:Name="DetailPanel" Grid.ColumnSpan="2" />

        <!-- 下载管理抽屉:挂在详情抽屉**之后**，所以「在详情里点下载 → 面板盖在详情上面」是自然层序。
             它自己认队列的状态(ViewModel.IsOpen)决定开合，页面不需要转发。 -->
        <views:ModDownloadPanel x:Name="DownloadPanel" Grid.ColumnSpan="2" />
    </Grid>
</Page>
