<Page
    x:Class="GIMI_ModManager.WinUI.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    xmlns:behaviors="using:GIMI_ModManager.WinUI.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:GIMI_ModManager.WinUI.Helpers"
    xmlns:i="using:Microsoft.Xaml.Interactivity"
    xmlns:l="using:WinUI3Localizer"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="OnLoaded"
    mc:Ignorable="d">
    <Grid>
        <Grid
            x:Name="AppTitleBar"
            Height="{Binding ElementName=NavigationViewControl, Path=CompactPaneLength}"
            VerticalAlignment="Top"
            Canvas.ZIndex="1"
            IsHitTestVisible="True">
            <Image
                Width="16"
                Height="16"
                HorizontalAlignment="Left"
                Source="/Assets/WindowIcon.ico" />
            <TextBlock
                x:Name="AppTitleBarText"
                Margin="32,0,0,0"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextWrapping="NoWrap" />

            <!--<StackPanel
                Grid.Column="1"
                Margin="0,0,200,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button Content="Refresh Mods" IsHitTestVisible="True" />
                <Button Margin="40,0,40,0" Content="Start Launcher" />
                <Button Content="Refresh Mods" />
            </StackPanel>-->
        </Grid>
        <NavigationView
            x:Name="NavigationViewControl"
            Canvas.ZIndex="0"
            DisplayModeChanged="NavigationViewControl_DisplayModeChanged"
            ExpandedModeThresholdWidth="1280"
            IsBackButtonVisible="Auto"
            IsBackEnabled="{x:Bind ViewModel.IsBackEnabled, Mode=OneWay}"
            IsEnabled="{x:Bind ViewModel.IsEnabled, Mode=OneWay}"
            IsPaneVisible="{x:Bind ViewModel.IsNotFirstTimeStartupPage, Mode=OneWay}"
            IsSettingsVisible="True"
            OpenPaneLength="220"
            SelectedItem="{x:Bind ViewModel.Selected, Mode=OneWay}">
            <!--<NavigationView.KeyboardAccelerators>
                <KeyboardAccelerator
                    Key="F10"
                    Invoked="KeyboardAccelerator_OnInvoked"
                    IsEnabled="True" />
            </NavigationView.KeyboardAccelerators>-->
            <NavigationView.MenuItems>
                <!--
                TODO: Update item titles by updating <x:Uid>.Content entries in Strings/en-us/Resources.resw.
                https://docs.microsoft.com/windows/uwp/app-resources/localize-strings-ui-manifest#refer-to-a-string-resource-identifier-from-xaml

                TODO: Update item icons by updating FontIcon.Glyph properties.
                https://docs.microsoft.com/windows/apps/design/style/segoe-fluent-icons-font#icon-list
                -->
                <!--<NavigationViewItem helpers:NavigationHelper.NavigateTo="GIMI_ModManager.WinUI.ViewModels.MainViewModel" Content="Main Overview">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xe7c3;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>-->


                <NavigationViewItem helpers:NavigationHelper.NavigateTo="GIMI_ModManager.WinUI.ViewModels.CharacterManagerViewModel" Content="Character Management" l:Uids.Uid="Shell_CharacterManagement">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xEB7E;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem helpers:NavigationHelper.NavigateTo="GIMI_ModManager.WinUI.ViewModels.ModsOverviewVM" Content="Mods Overview" l:Uids.Uid="Shell_ModsOverview">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xEA37;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>


                <NavigationViewItem helpers:NavigationHelper.NavigateTo="GIMI_ModManager.WinUI.ViewModels.ModMarketViewModel" Content="Mod Market" l:Uids.Uid="Shell_ModMarket">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE71D;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!--  Mod 商店（GameBanana）**暂时不上架，入口先藏起来**：页面、ViewModel、服务、
                      解析器、测试全都原样留着，页内功能也是完整的 —— 只是不给入口。
                      要重新上架：把下面这行 Visibility 去掉（或改成 Visible）即可，别的都不用动。  -->
                <NavigationViewItem Visibility="Collapsed" helpers:NavigationHelper.NavigateTo="GIMI_ModManager.WinUI.ViewModels.ModStoreViewModel" Content="Mod Store" l:Uids.Uid="Shell_ModStore">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE719;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem helpers:NavigationHelper.NavigateTo="GIMI_ModManager.WinUI.ViewModels.PresetViewModel" Content="Mod Presets" l:Uids.Uid="Shell_ModPresets">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xEA41;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem
                    x:Name="DebugItem"
                    helpers:NavigationHelper.NavigateTo="GIMI_ModManager.WinUI.ViewModels.DebugViewModel"
                    Content="Debug" l:Uids.Uid="Shell_Debug">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>



            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem helpers:NavigationHelper.NavigateTo="GIMI_ModManager.WinUI.ViewModels.NotificationsViewModel" Content="Notifications" l:Uids.Uid="Shell_Notifications">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE7E7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>



            <!--<NavigationView.HeaderTemplate>
                <DataTemplate>
                    <Grid>
                        <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="{Binding}" />
                    </Grid>
                </DataTemplate>
            </NavigationView.HeaderTemplate>-->
            <!--<i:Interaction.Behaviors>
                <behaviors:NavigationViewHeaderBehavior DefaultHeader="{x:Bind ((ContentControl)ViewModel.Selected).Content, Mode=OneWay}">
                    <behaviors:NavigationViewHeaderBehavior.DefaultHeaderTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </behaviors:NavigationViewHeaderBehavior.DefaultHeaderTemplate>
                </behaviors:NavigationViewHeaderBehavior>
            </i:Interaction.Behaviors>-->
            <Grid Margin="{StaticResource NavigationViewPageContentMargin}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  提权时的**常驻**提示。为什么不能只靠启动那个弹窗：它有「不再显示此警告」，
                      勾过一次就永远无声 —— 而提权真的会让拖拽安装整个失效（浮窗与主窗口同时只剩
                      禁止光标、松手没反应、且不报任何错）。用户报「拖动安装显示禁用」时，
                      多半就是在这个位置之前就已经没有任何地方告诉他原因了。
                      IsOpen 由代码后置在 Loaded 里按 AppElevation.IsDragDropBlocked() 置位。  -->
                <InfoBar
                    x:Name="ElevationNotice"
                    Grid.Row="0"
                    Margin="0,0,0,8"
                    IsClosable="True"
                    IsOpen="False"
                    Severity="Warning">
                    <InfoBar.ActionButton>
                        <!--  出路要摆在提示里：只告诉他"不可用"而不给一键解法，等于让他去找那个兼容性勾选  -->
                        <Button Click="ElevationNoticeRestart_Click" Content="以普通权限重新启动" l:Uids.Uid="ShellPage_ElevationNoticeAction" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <TeachingTip
                    Grid.Row="1"
                    Title="{x:Bind ViewModel.NotificationManager.ActiveNotification.Title, Mode=OneWay}"
                    IsOpen="{x:Bind ViewModel.NotificationManager.IsNotificationActive, Mode=TwoWay}"
                    Subtitle="{x:Bind ViewModel.NotificationManager.ActiveNotification.Subtitle, Mode=OneWay}" />
                <Frame x:Name="NavigationFrame" Grid.Row="1" />
            </Grid>
        </NavigationView>
    </Grid>

</Page>