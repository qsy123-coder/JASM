<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GIMI_ModManager.WinUI.Views.ModMarketPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:converters="using:CommunityToolkit.WinUI.UI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:l="using:WinUI3Localizer"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:GIMI_ModManager.WinUI.Views.Controls"
    xmlns:views="using:GIMI_ModManager.WinUI.Views"
    xmlns:models="using:GIMI_ModManager.WinUI.Models"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter
            x:Key="BoolToVisibilityConverter"
            TrueValue="Visible"
            FalseValue="Collapsed" />
        <converters:BoolToVisibilityConverter
            x:Key="InverseBoolToVisibilityConverter"
            TrueValue="Collapsed"
            FalseValue="Visible" />

        <DataTemplate x:Key="CategoryItemTemplate" x:DataType="models:ModMarketCategory">
            <Grid Padding="12,10" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="28" Height="28" CornerRadius="14">
                    <Grid>
                        <FontIcon FontSize="15" Glyph="&#xE8FD;"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image Width="28" Height="28" Stretch="UniformToFill">
                            <Image.Source>
                                <BitmapImage DecodePixelWidth="28" UriSource="{x:Bind ImageUri}" />
                            </Image.Source>
                        </Image>
                    </Grid>
                </Border>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="13"
                           Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="{x:Bind ModCount}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ModCardTemplate">
            <Border Width="250" Margin="6" CornerRadius="8"
                    BorderBrush="#E0E0E0" BorderThickness="0.5">
                <Grid Height="340">
                    <!-- 层0: 无图片时的占位背景 -->
                    <Grid Background="#2A2A2A">
                        <TextBlock Text="&#x1F5BC;" FontSize="32"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#555555" />
                    </Grid>
                    <!-- 层1: 图片铺满 -->
                    <Image Source="{Binding PreviewImageUrl}"
                           Stretch="UniformToFill"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                    <!-- 层2: NSFW 遮罩覆盖整卡 -->
                    <Border CornerRadius="8"
                            Visibility="{Binding IsNsfwBlurred, Converter={StaticResource BoolToVisibilityConverter}}"
                            Tapped="NsfwOverlay_Tapped" IsTapEnabled="True">
                        <Grid>
                            <Image Source="ms-appx:///Assets/66d9ecdd7558593ef412e76fc3582eb4.jpg"
                                   Stretch="UniformToFill" Opacity="0.92" />
                            <Border Background="#40000000">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#x1F51E;" FontSize="28"
                                               HorizontalAlignment="Center" Margin="0,0,0,4" />
                                    <TextBlock Text="NSFW 内容已隐藏" Foreground="White" FontSize="12"
                                               FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Text="点击查看" Foreground="#CCCCCC" FontSize="10"
                                               Margin="0,4,0,0" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <!-- 层3: 底部渐变条 -->
                    <Border VerticalAlignment="Bottom" Height="80">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="Transparent" Offset="0" />
                                <GradientStop Color="#B0000000" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <!-- 层4: 信息叠在底部 -->
                    <StackPanel VerticalAlignment="Bottom" Padding="8,0,8,6" Spacing="2">
                        <TextBlock Foreground="White" FontWeight="SemiBold" FontSize="13"
                                   MaxLines="2" Text="{Binding Title}"
                                   TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Width="16" Height="16" CornerRadius="8"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock VerticalAlignment="Center" FontSize="11"
                                       Foreground="#CCCCCC" Text="{Binding Character}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock VerticalAlignment="Center" FontSize="11"
                                       Foreground="#AAAAAA" Text="{Binding RelativeTime}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <FontIcon FontSize="11" Foreground="#AAAAAA" Glyph="&#xE890;" />
                                <TextBlock FontSize="11" Foreground="#AAAAAA" Text="{Binding Views}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <FontIcon FontSize="11" Foreground="#AAAAAA" Glyph="&#xEB52;" />
                                <TextBlock FontSize="11" Foreground="#AAAAAA" Text="{Binding LikesCount}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <FontIcon FontSize="11" Foreground="#AAAAAA" Glyph="&#xE8F2;" />
                                <TextBlock FontSize="11" Foreground="#AAAAAA" Text="{Binding CommentsCount}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <!-- 层5: NSFW 角标(右上) -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="4" Padding="6,2" Background="#FF4D4F"
                            CornerRadius="6"
                            Visibility="{Binding Nsfw, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Foreground="White" FontSize="10"
                                   FontWeight="SemiBold" Text="NSFW" />
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Sidebar -->
        <Grid Grid.Column="0"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,0,1,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Margin="16,16,16,8" FontSize="18" FontWeight="Bold"
                       l:Uids.Uid="ModMarket_CategoriesTitle" Text="分类" />
            <ListView x:Name="CategoryListView" Grid.Row="1"
                      ItemTemplate="{StaticResource CategoryItemTemplate}"
                      ItemsSource="{x:Bind ViewModel.Categories}"
                      SelectionMode="Single"
                      SelectionChanged="CategoryListView_SelectionChanged">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="4,0" />
                        <Setter Property="CornerRadius" Value="6" />
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
        </Grid>

        <!-- Right Main Panel -->
        <Grid Grid.Column="1" Background="#F5F7FA">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <Grid Grid.Row="0" MinHeight="50" Padding="12,8" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchBox" Grid.Column="0"
                         VerticalAlignment="Center" PlaceholderText="搜索模组..."
                         l:Uids.Uid="ModMarket_SearchPlaceholder"
                         Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         CornerRadius="6" Margin="0,0,8,0">
                    <TextBox.Resources>
                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="White" />
                        <SolidColorBrush x:Key="TextControlBackground" Color="White" />
                    </TextBox.Resources>
                </TextBox>

                <ComboBox Grid.Column="1" Width="110" VerticalAlignment="Center"
                          CornerRadius="6" Background="White" Margin="0,0,8,0"
                          ItemsSource="{x:Bind ViewModel.CategoryFilterOptions}"
                          SelectedItem="{x:Bind ViewModel.SelectedCategoryFilter, Mode=TwoWay}" />

                <ComboBox Grid.Column="2" Width="120" VerticalAlignment="Center"
                          CornerRadius="6" Background="White" Margin="0,0,8,0"
                          ItemsSource="{x:Bind ViewModel.ContentFilterOptions}"
                          SelectedItem="{x:Bind ViewModel.SelectedContentFilter, Mode=TwoWay}" />

                <ComboBox Grid.Column="3" Width="100" VerticalAlignment="Center"
                          CornerRadius="6" Background="White" Margin="0,0,8,0"
                          ItemsSource="{x:Bind ViewModel.SortOptions}"
                          SelectedItem="{x:Bind ViewModel.SelectedSortOption, Mode=TwoWay}" />

                <Button Grid.Column="4" Width="36" Height="36" VerticalAlignment="Center"
                        ToolTipService.ToolTip="下载管理" l:Uids.Uid="ModMarket_DownloadManager"
                        Background="Transparent" BorderThickness="0" CornerRadius="6"
                        Command="{x:Bind ViewModel.OpenDownloadManagerCommand}">
                    <FontIcon FontSize="16" Glyph="&#xE896;" />
                </Button>
            </Grid>

            <!-- Content Area -->
            <Grid Grid.Row="1">
                <ScrollViewer x:Name="CardScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalContentAlignment="Top"
                              ViewChanged="ScrollViewer_ViewChanged">
                    <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <local:WrapGridPanel x:Name="ModCardsPanel" Grid.Row="0"
                                                 VerticalAlignment="Top" />
                            <!-- 滚动加载更多指示器:ScrollViewer 内部最底部,作为内容流末尾,Collapsed 时不占位 -->
                            <StackPanel Grid.Row="1" HorizontalAlignment="Center"
                                        Margin="0,8,0,16"
                                        Visibility="{x:Bind ViewModel.IsLoadingMore, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                                <ProgressBar IsIndeterminate="True" Width="200" Height="4" />
                                <TextBlock Text="正在加载更多..." HorizontalAlignment="Center"
                                           Margin="0,4" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                </ScrollViewer>

                <!-- 首次加载/重载指示器:仅初始加载时显示在顶部 -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0"
                            Visibility="{x:Bind ViewModel.IsInitialLoading, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                    <ProgressBar IsIndeterminate="True" Width="200" Height="4" />
                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                               HorizontalAlignment="Center" Margin="0,4" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <Grid Background="#F5F7FA"
                      Visibility="{x:Bind ViewModel.IsEmpty, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="没有找到 Mod" />
                </Grid>

                <!-- Debug overlay(可隐藏/显示) -->
                <Border HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                        Margin="8" Padding="8,6" CornerRadius="4" Background="#DD000000"
                        MaxHeight="160"
                        Visibility="{x:Bind ViewModel.IsDebugPanelVisible, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <TextBlock Text="调试日志" Foreground="#AAA" FontSize="11"
                                       FontFamily="Consolas" VerticalAlignment="Center" />
                            <Button HorizontalAlignment="Right" Padding="8,2"
                                    Background="Transparent" BorderThickness="0"
                                    Command="{x:Bind ViewModel.ToggleDebugPanelCommand}">
                                <TextBlock Text="隐藏 ✕" Foreground="#AAA" FontSize="11" />
                            </Button>
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="DebugText" Foreground="#FF0" FontSize="11"
                                       FontFamily="Consolas" IsTextSelectionEnabled="True"
                                       Text="{x:Bind ViewModel.DebugInfo, Mode=OneWay}"
                                       TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- 调试面板隐藏后的重新显示按钮 -->
                <Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8"
                        Padding="10,4" CornerRadius="4" Background="#DD000000" BorderThickness="0"
                        Visibility="{x:Bind ViewModel.IsDebugPanelVisible, Converter={StaticResource InverseBoolToVisibilityConverter}, Mode=OneWay}"
                        Command="{x:Bind ViewModel.ToggleDebugPanelCommand}">
                    <TextBlock Text="调试" Foreground="#FF0" FontSize="11" FontFamily="Consolas" />
                </Button>
            </Grid>
        </Grid>

        <!-- Mod Detail Panel overlay (spans sidebar + main) -->
        <views:ModDetailPanel x:Name="DetailPanel" Grid.ColumnSpan="2" />
    </Grid>
</Page>
