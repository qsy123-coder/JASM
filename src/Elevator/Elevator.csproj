<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net7.0-windows10.0.19041.0</TargetFramework>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<PublishAot>true</PublishAot>
		<StripSymbols>true</StripSymbols>
		<Platforms>x64</Platforms>
		<BaseOutputPath></BaseOutputPath>
		<!-- 链接进来的 Core 源文件（见下面 ItemGroup）用了集合表达式，那是 C# 12 语法；
		     net7.0 的默认 LangVersion 是 11，不抬会编译不过。 -->
		<LangVersion>12</LangVersion>
		<!-- 能力标记，必须与 Core/Helpers 下的两个协议类对齐（每个能力各占一个版本号，只增不改）：
		     · ElevatorRefreshProtocol.MinimumFileVersionForTargetedRefresh = 2.0.0.0（带目标窗口的刷新 "2"）
		     · ElevatorKeySendProtocol.MinimumFileVersionForKeySend        = 3.0.0.0（送键 "3"）
		     主程序靠版本号判断助手认不认这些命令。旧版 Elevator.exe 没有版本信息，读出来天然是 1.0.0.0，
		     于是「低于某能力的最低版本」==「不认识那条命令」。
		     注意正在运行的 exe 无法被覆盖（文件被锁），所以磁盘上的版本 == 正在跑的那个进程的版本。 -->
		<FileVersion>3.0.0.0</FileVersion>
	</PropertyGroup>

	<!-- 按键协议与危险组合键护栏从 Core 链接进来，而不是 ProjectReference：
	     Core 是 net9.0 且拖着 Newtonsoft / Polly / SharpCompress，而本工程是 AOT + net7.0，
	     引用它会把整个 Core 拉进裁剪后的镜像。被链接的这两个文件是纯字符串逻辑、零依赖，
	     且恰好是唯二需要在两侧保持一致的安全相关代码（护栏分家 = 主程序拦得住、助手放过去）。
	     改动它们时注意：必须保持 net7.0 可编译，且不得引入任何 using 之外的新依赖。 -->
	<ItemGroup>
		<Compile Include="..\GIMI-ModManager.Core\Helpers\KeyChordGuard.cs" Link="Linked\KeyChordGuard.cs" />
		<Compile Include="..\GIMI-ModManager.Core\Helpers\KeyHelperProtocol.cs" Link="Linked\KeyHelperProtocol.cs" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="H.InputSimulator" Version="1.4.0" />
		<PackageReference Include="NamedPipeServerStream.NetFrameworkVersion" Version="1.1.13" />
	</ItemGroup>

</Project>
