<?xml version="1.0" encoding="utf-8" ?>
<!--
    Phase 0 原型窗口。这里**故意**只有一个诊断面板，没有 Mod 列表、没有缩略图、没有搜索 ——
    这一版只回答四个问题：看不看得见、点不点得动、会不会把游戏挤出全屏、热键在提权游戏前台时还有没有效。
    面板上的每一项都是为了在失败时能自己定位原因，而不是只告诉你"不行"。
-->
<winUiEx:WindowEx
    x:Class="JASM.OverlaySpike.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:winUiEx="using:WinUIEx"
    mc:Ignorable="d">

    <!--
        这里**故意不写** PointerPressed="OnRootPointerPressed"：Button 会自己处理 PointerPressed
        并把它标记为已处理，XAML 上的订阅收不到这类事件，点按钮时计数会纹丝不动
        （实测踩过：点了 8 次按钮，计数一直是 0，差点被误读成"NOACTIVATE 挡掉了鼠标输入"）。
        改在代码里用 AddHandler(..., handledEventsToo: true) 订阅，见 MainWindow.xaml.cs 构造函数。
    -->
    <Grid
        x:Name="RootGrid"
        RequestedTheme="Dark"
        Background="#FF101016">

        <!--
            为什么要手工覆盖按钮笔刷：默认 Button 样式用的是主题笔刷 ButtonBackground
            （= ControlFillColorDefaultBrush），深色主题下它约等于"6% 白"—— 铺在 #FF101016
            这种近黑底上肉眼几乎看不见，实测就是"按钮看都看不见"。亚克力模式下更惨，
            背景本身是半透明的，再叠一层半透明填充等于没有。
            所以这里不用主题色，直接给死一组实心填充 + 明显描边的配色，两种背景下都能看清。
            这些 key 就是默认 Button 样式在模板和 VisualState 里引用的名字，放在 RootGrid.Resources
            里即可覆盖全部后代按钮（ThemeResource 从元素往上找，能找到这里）。
        -->
        <Grid.Resources>
            <SolidColorBrush x:Key="ButtonBackground" Color="#FF39415C" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FF4C5578" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FF5C6791" />
            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#FF262A38" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#FF9AA4C4" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#FFC8D2F0" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#FFDCE4FF" />
            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#FF3A3F52" />
            <SolidColorBrush x:Key="ButtonForeground" Color="#FFF2F4FF" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#FF7A8098" />
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            无边框窗口没有标题栏，拖动区域必须自己造一个。
            用半透明而不是实心：亚克力模式下实心条会把背景糊掉，看起来像两种背景混在一起。
        -->
        <Border
            x:Name="DragStrip"
            Grid.Row="0"
            Padding="12,8"
            Background="#CC1E1E28"
            PointerMoved="OnDragStripPointerMoved"
            PointerPressed="OnDragStripPointerPressed"
            PointerReleased="OnDragStripPointerReleased">
            <TextBlock
                FontSize="12"
                Foreground="#FFE4E6F2"
                Text="⠿  Phase 0 浮窗原型 —— 拖这条可移动窗口" />
        </Border>

        <ScrollViewer Grid.Row="1" Padding="12,10">
            <StackPanel Spacing="4">

                <TextBlock
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="#FF8CF0AC"
                    Text="存活检查（每秒跳动 = 窗口在正常渲染，没被 NOACTIVATE 卡死）" />
                <TextBlock
                    x:Name="ClockText"
                    FontSize="22"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="--:--:--" />

                <TextBlock
                    Margin="0,8,0,0"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="#FF8CF0AC"
                    Text="鼠标输入（点窗口里**任意位置**，数字都要涨 = 点击能穿过 NOACTIVATE 到达窗口）"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="ClickCountText"
                    FontSize="22"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="0" />

                <TextBlock
                    Margin="0,8,0,0"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="#FF8CF0AC"
                    Text="窗口状态（这里的十六进制是**实时回读**的，不是我以为设了什么）"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="ExStyleText"
                    FontFamily="Consolas"
                    FontSize="12"
                    Foreground="#FFE4E6F2"
                    Text="扩展样式: -" />
                <TextBlock
                    x:Name="NoActivateText"
                    FontFamily="Consolas"
                    FontSize="12"
                    Foreground="#FFE4E6F2"
                    Text="WS_EX_NOACTIVATE: -"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="TopMostText"
                    FontSize="12"
                    Foreground="#FFE4E6F2"
                    Text="置顶: -"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="BackdropText"
                    FontSize="12"
                    Foreground="#FFE4E6F2"
                    Text="背景: -"
                    TextWrapping="Wrap" />

                <TextBlock
                    x:Name="ForegroundText"
                    Margin="0,4,0,0"
                    FontSize="12"
                    Foreground="#FFFFD08A"
                    Text="前台焦点: -"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="HotkeyText"
                    Margin="0,4,0,0"
                    FontSize="12"
                    Foreground="#FFFFD08A"
                    Text="热键: -"
                    TextWrapping="Wrap" />

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Padding="12,10" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <!--  这个按钮故意没有 Click 处理器：点它就是验证"控件能响应"，同时按下事件会冒泡到 RootGrid 被计数  -->
                <Button Content="点我试试控件响应" />
                <Button Click="OnToggleNoActivateClick" Content="切换不激活" />
                <Button Click="OnToggleTopMostClick" Content="切换置顶" />
                <Button Click="OnToggleBackdropClick" Content="切换背景" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Click="OnRecenterClick" Content="回到屏幕中央" />
                <Button Click="OnExitClick" Content="退出" />
            </StackPanel>
        </StackPanel>
    </Grid>
</winUiEx:WindowEx>